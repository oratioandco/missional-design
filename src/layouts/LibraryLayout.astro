---
import navLinks from '../../public/assets/editorial/research-navigation.json';
import EditorialLayout from './EditorialLayout.astro';
interface Props {title:string;description:string;active?:string;indexable?:boolean;}
const {title,description,active='screens',indexable=false}=Astro.props;
const links=navLinks.map(l=>[l.id,l.href,l.label]);
---
<EditorialLayout title={title} description={description} bodyClass="app-library" credits={['App icons and publisher screenshots: respective publishers via the Apple App Store. Research captures are labelled separately.']}>
 <Fragment slot="head"><link rel="stylesheet" href="/assets/app-library/library.css" /><link rel="stylesheet" href="/assets/app-library/app-profile.css" /></Fragment>
 <div class="lib-top wrap"><a class="lib-home" href="/screens/">Bible &amp; faith app library</a><nav class="lib-nav" aria-label="App library">{links.map(([key,url,label])=><a href={url} aria-current={key===active?'page':undefined}>{label}</a>)}</nav></div>
 <div class="wrap lib-page" data-pagefind-body={indexable?'':undefined} data-pagefind-ignore={indexable?undefined:'all'}><slot /></div>
</EditorialLayout>
