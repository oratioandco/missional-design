---
// Content pages (about, writing, canvas, guides, legal) share the editorial frame: the same masthead, footer,
// theme switch and type/colour tokens as home and principles. Their bodies keep their own markup; the shared
// rules that restyle it in the editorial system live in public/assets/editorial/site.css.
import EditorialLayout from './EditorialLayout.astro';
import { getLocaleFromPath, type Locale } from '../i18n/ui';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /**
   * Optional override. When omitted, locale is derived from the URL path
   * (`/de/...` → 'de', otherwise 'en').
   */
  lang?: Locale;
  /** Image credits shown in the footer colophon. */
  credits?: string[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = new URL(Astro.request.url).pathname;
const detectedLocale = getLocaleFromPath(pathname, base);
const { title, description, ogImage, lang = detectedLocale, credits = [] } = Astro.props;
const finalDescription = description ?? (lang === 'de'
  ? "Missional by Design — Strategische Gestaltung, theologische Reflexion und Innovation im Dienst für Gemeinden, Gründungen und alle, die Technologie für menschliches Gedeihen entwickeln."
  : "Missional by Design — Strategic design, theological reflection, and ministry innovation for churches, startups, and the teams building technology for human flourishing.");
---
<EditorialLayout title={title} description={finalDescription} ogImage={ogImage} lang={lang} credits={credits} bodyClass="site-page">
  <link slot="head" rel="stylesheet" href={`${base}/assets/editorial/site.css?v=1`} />
  <slot />
</EditorialLayout>
