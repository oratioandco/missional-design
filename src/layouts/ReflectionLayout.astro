---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; subtitle: string; lang: 'en' | 'de' }
const { title, subtitle, lang } = Astro.props;
---
<BaseLayout title={title} description={subtitle} lang={lang}>
 <article class="reflection">
  <header class="reflection-head container"><h1>{title}</h1><p class="lead">{subtitle}</p></header>
  <div class="reflection-body"><slot /></div>
 </article>
</BaseLayout>
<style>
.reflection{color:var(--color-ink)}.reflection-head{padding-top:clamp(40px,6vw,96px);padding-bottom:var(--s-5)}.reflection-head h1{font:400 clamp(44px,6.4vw,104px)/.96 var(--mbd-editorial);letter-spacing:-.022em;max-width:17ch;margin:0 0 28px}.reflection-head .lead{max-width:44rem;font:italic 400 clamp(22px,2vw,30px)/1.3 var(--serif);color:var(--muted)}.reflection-body{max-width:var(--max);margin:auto;padding:var(--s-5) var(--gutter) 88px;border-top:1px solid var(--rule)}.reflection-body>:global(*){max-width:42rem}.reflection-body :global(p),.reflection-body :global(li){font:400 18px/1.75 var(--font-body);margin-bottom:24px}.reflection-body :global(h2){font:400 clamp(32px,4vw,46px)/1.12 var(--mbd-editorial);margin:52px 0 24px}.reflection-body :global(h3){font:400 28px/1.2 var(--mbd-editorial);margin:32px 0 18px}.reflection-body :global(a){text-decoration:underline;text-underline-offset:4px}.reflection-body :global(aside){border-top:1px solid var(--color-border);margin-top:48px;padding-top:24px}.reflection-body :global(aside p){font-size:15px;line-height:1.65}.reflection-body :global(ul){padding-left:22px}@media(max-width:600px){.reflection-head{padding-top:40px;padding-bottom:32px}.reflection-head h1{font-size:44px}.reflection-head .lead{font-size:22px}}
</style>
