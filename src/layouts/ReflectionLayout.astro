---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; subtitle: string; lang: 'en' | 'de' }
const { title, subtitle, lang } = Astro.props;
---
<BaseLayout title={title} description={subtitle} lang={lang}>
 <article class="reflection">
  <header class="reflection-head container"><h1>{title}</h1><p class="lead">{subtitle}</p></header>
  <div class="reflection-body"><slot /></div>
 </article>
</BaseLayout>
<style>
.reflection{background:var(--color-white);color:var(--color-ink)}.reflection-head{padding-top:72px;padding-bottom:48px}.reflection-head h1{font:400 clamp(48px,6.5vw,88px)/1.04 var(--mbd-editorial);letter-spacing:-.02em;max-width:20ch;margin:20px 0 28px}.reflection-head .lead{max-width:48ch;font-size:23px;line-height:1.45}.reflection-body{max-width:760px;margin:auto;padding:0 28px 88px}.reflection-body :global(p),.reflection-body :global(li){font:400 18px/1.75 var(--font-body);margin-bottom:24px}.reflection-body :global(h2){font:400 clamp(32px,4vw,46px)/1.12 var(--mbd-editorial);margin:52px 0 24px}.reflection-body :global(h3){font:400 28px/1.2 var(--mbd-editorial);margin:32px 0 18px}.reflection-body :global(a){text-decoration:underline;text-underline-offset:4px}.reflection-body :global(aside){border-top:1px solid var(--color-border);margin-top:48px;padding-top:24px}.reflection-body :global(aside p){font-size:15px;line-height:1.65}.reflection-body :global(ul){padding-left:22px}@media(max-width:600px){.reflection-head{padding-top:40px;padding-bottom:32px}.reflection-head h1{font-size:48px}.reflection-head .lead{font-size:21px}}
</style>
