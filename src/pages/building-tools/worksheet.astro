---
import BaseLayout from '../../layouts/BaseLayout.astro';
import rubric from '../../data/app-design-rubric.json';
const fields=[{id:'feature',label:'The feature or decision',hint:'Describe the choice your team can actually change.'},{id:'people',label:'People and context',hint:'Whom does it serve? Who is most likely to be overlooked or hurt?'},{id:'evidence',label:'What we know and what remains uncertain',hint:'Include observed behaviour, sources and whose experience is still missing.'}];
---
<BaseLayout title="Principle review worksheet" description="Review one product decision against ten Christian design principles. Record evidence, questions and a practical next step, then print or save your work.">
 <link rel="stylesheet" href="/assets/building-tools/tools.css" />
 <div class="tools-wrap worksheet" data-principle-worksheet>
  <header class="worksheet-heading"><p class="worksheet-back"><a href="/building-tools/">Building tools</a></p><h1>Review one decision.</h1><p class="tools-lead">Ten principle questions for a conversation with your team.</p><p>This is a discernment worksheet, not a score or certification. Start with the people affected, distinguish evidence from assumptions and choose a next step together.</p><div class="worksheet-actions"><button type="button" data-print>Print or save as PDF</button><button type="button" data-download>Download answers</button><p role="status" data-worksheet-status></p></div><p class="worksheet-note">Answers stay in this page and are not sent to a server or automatically saved. Download or print before closing it. A downloaded file is a record; this page does not import it.</p><noscript><p>Use your browser’s Print command to print a blank copy, or fill in the fields and print. Downloading answers needs JavaScript.</p></noscript></header>
  <form aria-label="Principle review" autocomplete="off" onsubmit="return false">
   <section class="worksheet-context" aria-label="The decision and its context">{fields.map(f=><div class="worksheet-field"><label for={f.id}>{f.label}</label><p id={f.id+'-hint'}>{f.hint}</p><textarea id={f.id} name={f.id} rows="3" aria-describedby={f.id+'-hint'} maxlength="30000"></textarea><div class="print-answer" data-print-for={f.id} aria-hidden="true"></div></div>)}</section>
   <section aria-labelledby="principle-questions"><h2 id="principle-questions">Work through the principles.</h2><p>Discuss each question. Record evidence, tensions or a reason it does not apply to this decision. You do not need to invent a positive answer.</p><div class="principle-review">{rubric.principles.map(p=><section class="principle-response"><div><h3><a href={p.url}>{p.name}</a></h3><p id={p.id+'-question'}>{p.question}</p></div><div><label for={'answer-'+p.id}>Evidence, response or open question</label><textarea id={'answer-'+p.id} name={p.id} rows="3" aria-describedby={p.id+'-question'} maxlength="30000"></textarea><div class="print-answer" data-print-for={'answer-'+p.id} aria-hidden="true"></div></div></section>)}</div></section>
   <section class="worksheet-next" aria-labelledby="next-step"><h2 id="next-step">Agree on a next step.</h2>{[{id:'choice',label:'Our decision and the alternatives we considered'},{id:'test',label:'What we will test, with whom, and what could change our mind'},{id:'responsibility',label:'Who will act, and when we will return to this'}].map(f=><div class="worksheet-field"><label for={f.id}>{f.label}</label><textarea id={f.id} name={f.id} rows="3" maxlength="30000"></textarea><div class="print-answer" data-print-for={f.id} aria-hidden="true"></div></div>)}</section>
  </form>
  <footer class="worksheet-credit"><p>Missional by Design · <a href="https://missional.design/building-tools/worksheet/">missional.design/building-tools/worksheet/</a></p><p>Original worksheet: CC BY 4.0, Tobias Treppmann. The principles remain a draft for theological and pastoral review.</p></footer>
 </div>
 <script src="../../scripts/principle-worksheet.ts"></script>
</BaseLayout>
