---
import Layout from '../../layouts/LibraryLayout.astro';
import Search from '../../components/library/SearchForm.astro';
import {apps,organisationFor,screensFor} from '../../lib/app-library';
---
<Layout title="Bible and faith apps" description="Explore Bible and faith apps, their publishers and real captured interfaces." active="apps"><header class="lib-intro"><h1>Apps, in practice.</h1><p>What each app does, whom it serves and how its interface makes room for faith.</p><p class="lib-note">A growing research collection. Profiles and screenshot coverage vary by app.</p></header><Search kind="app" label="Find an app"/><div class="lib-section-heading"><h2>App profiles</h2><span>{apps.length} apps</span></div><div class="lib-directory">{apps.slice().sort((a,b)=>a.name.localeCompare(b.name)).map(a=><article class="lib-directory-row"><div><h3><a href={a.url}>{a.name}</a></h3><p>{a.description}</p><small><a href={organisationFor(a.organisation_id).url}>{organisationFor(a.organisation_id).name}</a></small></div><span class="lib-directory-count">{screensFor(a.id).length} screenshots</span></article>)}</div></Layout>
