---
import AppIcon from '../../components/library/AppIcon.astro';
import Layout from '../../layouts/LibraryLayout.astro';
import {apps,organisationFor,screensFor} from '../../lib/app-library';
import assessments from '../../data/app-assessments.json';
const key=(label:string)=>label.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const ingredientsFor=new Map(assessments.apps.map((x:any)=>[x.app_id,(x.ingredients||[]).map((i:any)=>key(i.label))]));
const labels=new Map<string,string>();const counts=new Map<string,number>();
for(const x of assessments.apps as any[])for(const i of x.ingredients||[]){const k=key(i.label);labels.set(k,i.label);counts.set(k,(counts.get(k)||0)+1);}
const top=[...counts].filter(([,n])=>n>1).sort((a,b)=>b[1]-a[1]).slice(0,14);
---
<Layout title="Bible and faith apps" description="Explore Bible and faith apps, their publishers and real captured interfaces." active="apps"><header class="lib-intro"><h1>Apps, in practice.</h1><p>What each app does, whom it serves and how its interface makes room for faith.</p><p class="lib-note">A growing research collection. Profiles and screenshot coverage vary by app.</p></header><p class="lib-note"><a href="/apps/assessment/">How we assess ingredients, design and user response</a></p><div class="lib-app-filter"><label for="app-name-filter">Find an app</label><input id="app-name-filter" type="search" placeholder="Name or publisher" autocomplete="off"/><nav class="lib-type-chips" aria-label="Filter by design question">{top.map(([k,n])=><a href={'?ingredient='+k} data-ingredient-chip={k}>{labels.get(k)} <span>{n}</span></a>)}</nav><p class="lib-note" id="app-filter-status" aria-live="polite"></p></div><div class="lib-section-heading"><h2>App profiles</h2><span>{apps.length} apps</span></div><div class="lib-directory">{apps.slice().sort((a,b)=>a.name.localeCompare(b.name)).map(a=><article class="lib-directory-row lib-app-row" data-ingredients={(ingredientsFor.get(a.id)||[]).join(' ')} data-name={(a.name+' '+organisationFor(a.organisation_id).name).toLowerCase()}><AppIcon app={a}/><div><h3><a href={a.url}>{a.name}</a></h3><p>{a.description}</p><small><a href={organisationFor(a.organisation_id).url}>{organisationFor(a.organisation_id).name}</a></small></div><span class="lib-directory-count">{screensFor(a.id).length} research capture{screensFor(a.id).length===1?'':'s'}</span></article>)}</div></Layout>
<script>
 const params=new URLSearchParams(location.search);const ingredient=params.get('ingredient')||'';
 const rows=[...document.querySelectorAll<HTMLElement>('.lib-app-row')];const input=document.getElementById('app-name-filter') as HTMLInputElement;const status=document.getElementById('app-filter-status')!;
 document.querySelectorAll<HTMLAnchorElement>('[data-ingredient-chip]').forEach(chip=>{if(chip.dataset.ingredientChip===ingredient){chip.setAttribute('aria-current','true');chip.href='/apps/';}});
 function apply(){const q=input.value.trim().toLowerCase();let shown=0;for(const row of rows){const ok=(!ingredient||row.dataset.ingredients!.split(' ').includes(ingredient))&&(!q||row.dataset.name!.includes(q));row.hidden=!ok;if(ok)shown++;}
  const chip=document.querySelector<HTMLAnchorElement>('[data-ingredient-chip="'+ingredient+'"]');status.textContent=ingredient||q?shown+' of '+rows.length+' apps'+(ingredient?' with '+(chip?.firstChild?.textContent?.trim()||ingredient.replace(/-/g,' ')):'')+(ingredient?' · select the feature again to clear':''):'';}
 input.addEventListener('input',apply);apply();
</script>
