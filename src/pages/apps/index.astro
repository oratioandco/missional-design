---
import AppIcon from '../../components/library/AppIcon.astro';
import Layout from '../../layouts/LibraryLayout.astro';
import {apps,organisationFor,screensFor} from '../../lib/app-library';
import assessments from '../../data/app-assessments.json';
const key=(label:string)=>label.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const ingredientsFor=new Map(assessments.apps.map((x:any)=>[x.app_id,(x.ingredients||[]).map((i:any)=>key(i.label))]));
const labels=new Map<string,string>();const counts=new Map<string,number>();
for(const x of assessments.apps as any[])for(const i of x.ingredients||[]){const k=key(i.label);labels.set(k,i.label);counts.set(k,(counts.get(k)||0)+1);}
const top=[...counts].filter(([,n])=>n>1).sort((a,b)=>b[1]-a[1]).slice(0,14);
const FEATURES:[string,string,string[]][]=[['ai-chat','AI chat',['Chat','AI persona','AI disclosure']],['audio','Audio',['Audio playback']],['reading-plans','Reading plans',['Reading plan']],['prayer','Prayer',['Prayer']],['devotionals','Devotionals',['Devotionals']],['community','Community',['Community']],['highlights-notes','Highlights and notes',['Highlight','Note','Bookmark']],['study-helps','Study helps',['Study helps']],['translations','Translations',['Translation']],['reminders','Reminders',['Reminders']],['progress','Streaks and progress',['Progress']],['giving','Giving',['Donation']],['video','Video',['Video']],['paid-upgrade','Paid upgrade',['Upsell']]];
const featuresFor=(id:string)=>{const tags=new Set(screensFor(id).flatMap(s=>s.tags));return FEATURES.filter(([,,t])=>t.some(x=>tags.has(x))).map(([k])=>k);};
const featureCounts=FEATURES.map(([k,label])=>[k,label,apps.filter(a=>featuresFor(a.id).includes(k)).length] as [string,string,number]).filter(([,,n])=>n>0);
---
<Layout title="Bible and faith apps" description="Explore Bible and faith apps, their publishers and real captured interfaces." active="apps"><header class="lib-intro"><h1>Apps, in practice.</h1><p>What each app does, whom it serves and how its interface makes room for faith.</p><p class="lib-note">A growing research collection. Profiles and screenshot coverage vary by app.</p></header><p class="lib-note"><a href="/apps/assessment/">How we assess ingredients, design and user response</a> · <a href="/apps/ai-chat/">Faith chat apps, side by side</a></p><div class="lib-app-filter"><label for="app-name-filter">Find an app</label><input id="app-name-filter" type="search" placeholder="Name or publisher" autocomplete="off"/><p class="lib-filter-label">Features seen in reviewed screens</p><nav class="lib-type-chips" aria-label="Filter by feature">{featureCounts.map(([k,label,n])=><a href={'?feature='+k} data-feature-chip={k}>{label} <span>{n}</span></a>)}</nav><p class="lib-note" id="app-filter-status" aria-live="polite"></p></div><div class="lib-section-heading"><h2>App profiles</h2><span>{apps.length} apps</span></div><div class="lib-directory">{apps.slice().sort((a,b)=>a.name.localeCompare(b.name)).map(a=><article class="lib-directory-row lib-app-row" data-ingredients={(ingredientsFor.get(a.id)||[]).join(' ')} data-features={featuresFor(a.id).join(' ')} data-name={(a.name+' '+organisationFor(a.organisation_id).name).toLowerCase()}><AppIcon app={a}/><div><h3><a href={a.url}>{a.name}</a></h3><p>{a.description}</p><small><a href={organisationFor(a.organisation_id).url}>{organisationFor(a.organisation_id).name}</a></small></div><span class="lib-directory-count">{screensFor(a.id).length} research capture{screensFor(a.id).length===1?'':'s'}</span></article>)}</div></Layout>
<script>
 const params=new URLSearchParams(location.search);const ingredient=params.get('ingredient')||'';const feature=params.get('feature')||'';
 const rows=[...document.querySelectorAll<HTMLElement>('.lib-app-row')];const input=document.getElementById('app-name-filter') as HTMLInputElement;const status=document.getElementById('app-filter-status')!;
 const chip=document.querySelector<HTMLAnchorElement>('[data-feature-chip="'+feature+'"]');if(chip){chip.setAttribute('aria-current','true');chip.href='/apps/';}
 const what=feature?(chip?.firstChild?.textContent?.trim()||feature):ingredient?ingredient.replace(/-/g,' '):'';
 function apply(){const q=input.value.trim().toLowerCase();let shown=0;for(const row of rows){const ok=(!feature||row.dataset.features!.split(' ').includes(feature))&&(!ingredient||row.dataset.ingredients!.split(' ').includes(ingredient))&&(!q||row.dataset.name!.includes(q));row.hidden=!ok;if(ok)shown++;}
  status.replaceChildren();if(what||q){status.append(shown+' of '+rows.length+' apps'+(what?' with '+what.toLowerCase():'')+' ');if(what){const clear=document.createElement('a');clear.href='/apps/';clear.textContent='Clear filter';status.append(clear);}}}
 input.addEventListener('input',apply);apply();
</script>
