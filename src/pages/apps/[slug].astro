---
import AppAssessment from '../../components/library/AppAssessment.astro';
import AppIcon from '../../components/library/AppIcon.astro';
import AppStoreGallery from '../../components/library/AppStoreGallery.astro';
import Layout from '../../layouts/LibraryLayout.astro';
import ScreenGrid from '../../components/library/ScreenGrid.astro';
import {apps,screensFor,organisationFor,flows,dateLabel,articleTitle} from '../../lib/app-library';
export function getStaticPaths(){return apps.map(app=>({params:{slug:app.slug},props:{app}}));}
const {app:a}=Astro.props;const org=organisationFor(a.organisation_id);const shots=screensFor(a.id);const sequences=flows.filter(f=>f.app_id===a.id);const articles=[...new Set(shots.flatMap(s=>s.article_slugs))];
---
<Layout title={a.name} description={a.description} active="apps" indexable><span hidden data-pagefind-meta="record_id">{'app:'+a.id}</span><span hidden data-pagefind-filter="kind">app</span><header class="lib-intro"><a class="lib-back" href="/apps/">All apps</a><div class="lib-app-heading"><AppIcon app={a} size={76}/><h1 data-pagefind-meta="title">{a.name}</h1></div><p data-pagefind-meta="description">{a.description}</p><div class="lib-links"><a href={org.url}>Organisation: {org.name}</a>{a.website&&<a href={a.website} rel="noreferrer" target="_blank">Official website</a>}<a href={a.app_store_url} rel="noreferrer" target="_blank">App Store</a></div></header><nav class="lib-links" aria-label="On this app profile"><a href="#ingredients">Ingredients and design</a><a href="#user-response">User response</a><a href="#research-captures">Research captures</a></nav><div class="lib-facts-columns"><section><h2>Who it serves</h2><p>{a.target_audience.text}</p><p class="lib-note">An editorial summary of publisher positioning. <a href={a.target_audience.source_url} rel="noreferrer" target="_blank">Source</a></p></section><section><h2>App facts</h2><dl class="lib-dl"><div><dt>Platform</dt><dd>{a.platform}</dd></div><div><dt>Store category</dt><dd>{a.category}</dd></div><div><dt>Store version at lookup</dt><dd>{a.version}</dd></div><div><dt>First store release</dt><dd>{dateLabel(a.first_store_release)}</dd></div><div><dt>Store ratings</dt><dd>{a.store_rating.count.toLocaleString('en-GB')} in {a.store_rating.country.toUpperCase()} at lookup</dd></div></dl><p class="lib-note">Ratings are not downloads or active users. App Store facts checked {dateLabel(a.checked)}.</p></section></div><section class="lib-section"><h2>Revenue and reach</h2><p>App-specific revenue and active user numbers have not been verified in the sources reviewed. <a href={org.url+'#figures'}>See the organisation profile</a> for separately scoped figures where available.</p></section><AppAssessment app={a}/><AppStoreGallery app={a}/><section class="lib-section" id="research-captures"><div class="lib-section-heading"><h2>Research captures</h2><span>{shots.length} captured screen{shots.length===1?'':'s'}</span></div>{shots.length?<ScreenGrid screens={shots}/>:<p class="lib-muted">No research captures for this app are published yet. Explore the publisher’s App Store images above.</p>}<p class="lib-note">Capture dates and versions belong to individual screens. These examples do not establish complete coverage of the app.</p></section>{sequences.length>0&&<section class="lib-section"><h2>Captured sequences</h2><ul class="lib-link-list">{sequences.map(f=><li><a href={f.url}>{f.title}</a><p>{f.context}</p></li>)}</ul></section>}{articles.length>0&&<section class="lib-section"><h2>Explore the design questions</h2><ul class="lib-link-list">{articles.map(s=><li><a href={'/patterns/'+s+'/'}>{articleTitle(s)}</a></li>)}</ul></section>}</Layout>
