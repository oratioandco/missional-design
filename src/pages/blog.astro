---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang="en" title="Writing">
  <section class="hero text-hero">
    <div class="hero-label">Missional by Design · Writing</div>
    <h1>Writing.</h1>
    <p class="hero-subtitle">
      Essays on missional design, digital formation, ministry innovation, and the surprising overlap between churches and
      startups. Questions and practical implications for the work we share.
    </p>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 900px;">
        <a href={`${base}/blog/which-rock/`} class="post-card">
          <div class="post-card-meta"><span class="post-card-tag">Essay · 2026</span></div>
          <h2 class="post-card-title">On Which Rock Are We Building?</h2>
          <p class="post-card-excerpt">AI, spiritual formation and our responsibilities toward God, the church and our neighbors. What does success mean when people need a product less?</p>
          <div class="post-card-read">Read the essay →</div>
        </a>

        <!-- Published post -->
        <a href={`${base}/blog/churches-and-startups`} class="post-card">
          <div class="post-card-meta">
            <span class="post-card-tag">Essay</span>
            <span class="post-card-date">2026</span>
          </div>
          <h2 class="post-card-title">Why churches and startups have more in common than you think.</h2>
          <p class="post-card-excerpt">
            Grand vision, limited resources, fluid context. The surprising overlap between two seemingly opposite worlds — and
            what each can learn from the other.
          </p>
          <div class="post-card-read">Read the essay →</div>
        </a>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-card {
    display: block;
    padding: 3rem 0;
    border-top: 1px solid var(--rule-strong);
    text-decoration: none;
    color: var(--color-black);
    transition: opacity var(--transition);
  }
  .post-card:last-of-type {
    border-bottom: 1px solid var(--rule-strong);
  }
  .post-card:hover {
    border-top-color: var(--color-black);
  }
  .post-card-placeholder {
    opacity: 0.45;
    pointer-events: none;
  }
  .post-card-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font: 500 var(--t-micro)/1.3 var(--sans);
    letter-spacing: 0.05em;
    color: var(--faint);
  }
  .post-card-tag,
  .post-card-date {
    color: var(--faint);
  }
  .post-card-title {
    font: 400 clamp(32px, 3.6vw, 52px)/1.04 var(--serif);
    letter-spacing: -0.014em;
    margin-bottom: 1.5rem;
    max-width: 22ch;
  }
  .post-card-excerpt {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: 1.25rem;
  }
  .post-card-read {
    font: 500 var(--t-small)/1.4 var(--sans);
    letter-spacing: 0.01em;
  }
</style>
