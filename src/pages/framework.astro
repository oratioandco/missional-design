---
// Missional by Design: principles for spiritual apps (replaces the eight principles, 11 October 2026; draft for review).
// Five places, two commitments in each, derived from the calling (patterns.missional.design/calling/) and read through
// Praxis's Redemptive Frame. The full derivations, sources and test questions live on
// patterns.missional.design/principles/; this page is the short form.
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailLink from '../components/EmailLink.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const full = 'https://patterns.missional.design/principles/';

const places = [
  {
    num: '01',
    name: 'The Word',
    ask: 'What do we put in front of people as God’s word, or about it?',
    commitments: [
      {
        id: 'word-distinct',
        title: 'Keep the Word distinct, and teach it truly.',
        body: 'Every screen teaches, and those who teach are judged more strictly. Let readers always tell Scripture from our words, and our words from a machine’s: label every heading, note and answer, show the traditions where Christians differ, and keep a verse inside its passage.',
      },
      {
        id: 'speak-for-god',
        title: 'Never speak for God.',
        body: 'An app may quote, explain, pray the church’s prayers and point. It must never pronounce, promise or plead in God’s name, nor let a persona or a machine take the place of a person or of God. The Lord’s Prayer, a psalm or a written liturgy are the church’s words, offered as such; the persona that claims a relationship, and the promise that claims God’s answer, are not ours to make.',
      },
    ],
  },
  {
    num: '02',
    name: 'The person',
    ask: 'How do we receive the one holding the phone?',
    commitments: [
      {
        id: 'most-vulnerable',
        title: 'Design for the most vulnerable first.',
        body: 'Design first for the person most likely to be hurt: in crisis, grieving, abused, scrupulous, new to faith, hurt by a church, or, where an app serves them, a child. Help comes before features, verses or answers, and a way to a person is never behind an account, a limit or a paywall.',
      },
      {
        id: 'welcome',
        title: 'Welcome before you ask, and guard what is told in confidence.',
        body: '“Come and see.” Let people reach what they came for before asking anything, ask only for what serves them when it does, and treat what they tell you to pray as holy ground: never marketing data, never stored by default.',
      },
    ],
  },
  {
    num: '03',
    name: 'The practice',
    ask: 'What do we ask of their time, attention and money, and when do we stop?',
    commitments: [
      {
        id: 'feed-the-flock',
        title: 'Feed the flock, not on it.',
        body: 'Attention, time, devotion and money are entrusted, not harvested. Ask for them honestly, never through guilt, fear, urgency or a promise: no streak warnings marked urgent, no “we miss you” in a persona’s voice, no tier chosen for the giver.',
      },
      {
        id: 'enough',
        title: 'Make room for rest, and say when it is enough.',
        body: 'The Sabbath was made for people. A faithful product sometimes asks for less: it ends a session, keeps the night quiet, stops asking when the need is met, as Moses stopped the offerings when there was more than enough, and lets itself end when its work is done.',
      },
    ],
  },
  {
    num: '04',
    name: 'The people',
    ask: 'Where do we send them, and what do we claim to have grown?',
    commitments: [
      {
        id: 'send',
        title: 'Send people to God and to one another.',
        body: 'The app is a means, never the destination. Judge it by where people go when they close it: to Scripture, to prayer, to a church, a group, a friend. For someone isolated or hurt by a church, an online community may be the safe place; the bridge must lead somewhere chosen and safe.',
      },
      {
        id: 'growth',
        title: 'Plant and water; leave the growth to God.',
        body: 'Measure what serves the person and the task: usability, understanding, burden, harm. Never score a soul, never present usage as spiritual fruit, and never claim the fruit as yours.',
      },
    ],
  },
  {
    num: '05',
    name: 'The makers',
    ask: 'Who are we becoming as we build?',
    commitments: [
      {
        id: 'offering',
        title: 'Make it well, as an offering.',
        body: 'God filled Bezalel with skill for his work. Excellence, accessibility, beauty and care are how we love God and the person on the other side of the screen. “It’s for ministry” is never an excuse for careless work.',
      },
      {
        id: 'trembling',
        title: 'Hold it with joy and trembling, before God and others.',
        body: 'Rejoice in the work and take its weight: pray for the people who use it, invite those who can say no early, confess mistakes plainly, and tend what you release.',
      },
    ],
  },
];

const ways = [
  {
    label: 'Exploitative',
    praxis: '“I win, you lose”',
    body: 'The app takes the place. It borrows God’s voice to bring people back, sells access to prayer or a promise of blessing, keeps confidences as data and counts faith as usage. Name it. Refuse it.',
  },
  {
    label: 'Ethical',
    praxis: '“I win, you win”',
    body: 'The app keeps its place: safe, honest, accessible, lawful, careful with data and time. This is the floor and a gift of common grace, but it is not the goal.',
  },
  {
    label: 'Redemptive',
    praxis: '“I sacrifice, we win”',
    body: 'The app points beyond itself. It withholds claims it could make on attention, data, money and trust, tells the truth about itself, and is glad when people close it to go to God and to one another.',
  },
];

const became = [
  ['Reverence', 'Design for the most vulnerable first · Welcome before you ask'],
  ['Hospitality', 'Welcome before you ask · Make it well, as an offering'],
  ['Rootedness', 'Keep the Word distinct, and teach it truly'],
  ['Bridge', 'Send people to God and to one another'],
  ['Grace', 'Feed the flock, not on it · Make room for rest'],
  ['Honesty', 'Never speak for God · Keep the Word distinct'],
  ['Costliness', 'The thread through all ten: what each asks the maker to give up'],
  ['Fruit', 'Plant and water; leave the growth to God'],
];

const tensions = [
  {
    title: 'Rhythm vs. pressure',
    body: 'Feed the flock, and make room for rest. A spiritual life needs rhythm, but the moment a rhythm becomes an enforced expectation it turns into pressure. Invite people into rhythm, and after silence ask once, then stop.',
  },
  {
    title: 'Community vs. starting alone',
    body: 'Send people to one another, and design for the most vulnerable first. Many begin alone, and some were hurt in a church. Build bridges that invite toward community rather than making it the price of entry.',
  },
  {
    title: 'Devotion vs. a voice that is not God’s',
    body: 'Never speak for God, and welcome before you ask. Offer the church’s prayers as the church’s, keep a way to a person first, and let no persona say it will pray.',
  },
];

const questions = [
  'Does this serve growth in faith, or only the usage numbers?',
  'Freedom or anxiety?',
  'Would we put our own name under this sentence, or are we borrowing God’s?',
  'Who is the most vulnerable person likely to use this today, and what will they see?',
  'If a user had a spiritually dry year, would they feel welcomed back or judged?',
  'If people developed deep communion with God and no longer needed the app, would we celebrate or mourn?',
];
---

<BaseLayout lang="en" title="The Framework">
  <!-- Hero -->
  <section class="hero" style="min-height: 60vh;">
    <img class="brand-hero-media" src={`${base}/assets/brand/hero-dark.webp?v=fractures-2`} alt="" aria-hidden="true" width="2400" height="1500" fetchpriority="high" />
    <div class="hero-label">Missional by Design · Principles for spiritual apps</div>
    <h1>Five places.<br/>Ten commitments.</h1>
    <p class="hero-subtitle">
      A spiritual tool never designs only a function. It designs an encounter between a person and what they hold most
      sacred. These principles come from a calling: the joy and the weight of building the tools people now pray, read and
      ask with. Each names what it asks the maker to give up.
    </p>
  </section>

  <!-- Three layers -->
  <section class="section">
    <div class="container">
      <div style="max-width: 70ch;">
        <p class="lead">
          <a href="https://patterns.missional.design/calling/">The calling</a> says why this work matters and how heavy it
          is. The principles below say what we hold, with questions to test a design.
          <a href="https://patterns.missional.design/patterns/">The deep dives</a> show how, option by option.
        </p>
      </div>
    </div>
  </section>

  <!-- Three ways -->
  <section class="section section-cream">
    <div class="container">
      <div style="margin-bottom: 3rem; max-width: 60ch;">
        <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.6;">Three ways to build</div>
        <h2>Exploitative, ethical,<br/>redemptive.</h2>
        <p class="lead" style="margin-top: 2rem;">
          The three ways are the work of <a href="https://www.praxis.co/redemptive-entrepreneurship">Praxis</a>, whose
          Redemptive Frame calls the redemptive way “creative restoration through sacrifice”. We read it for apps whose
          subject is God, where the first temptation is not only to use people but to use God’s name.
          <a href="https://www.faithtech.com/digital-playbook/a-way-of-building-redemptively">FaithTech’s Playbook</a> makes the same turn with reckless,
          responsible and redemptive technology. The reading is ours; we are grateful to both.
        </p>
      </div>
      <div class="grid grid-3">
        {ways.map((w) => (
          <div style="padding: 2rem; background: var(--color-white); border: 1px solid var(--color-black);">
            <h4 style="margin-bottom: 0.5rem;">{w.label}</h4>
            <p style="font-size: 0.85rem; opacity: 0.7; margin-bottom: 1rem;">Praxis: {w.praxis}</p>
            <p style="font-size: 0.95rem; line-height: 1.5;">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Places and commitments -->
  <section class="section">
    <div class="container">
      <div style="max-width: 70ch;">
        {places.map((p) => (
          <article class="principle">
            <img class="brand-place-art" src={`${base}/assets/brand/${({'01':'word','02':'person','03':'practice','04':'people','05':'makers'}[p.num])}-light.webp?v=fractures-2`} alt="" loading="lazy" width="2000" height="1250" />
            <span class="principle-number">{p.num}</span>
            <h3>{p.name}</h3>
            <p class="lead" style="opacity: 0.75;">{p.ask}</p>
            {p.commitments.map((c) => (
              <div style="margin-top: 1.5rem;">
                <h4><a href={`${full}${c.id}/`}>{c.title}</a></h4>
                <p>{c.body}</p>
              </div>
            ))}
          </article>
        ))}
        <p class="lead" style="margin-top: 3rem;">
          Each principle, with its Scripture, tradition, what it rules in and out, and questions to test a design:
          <a href={full}>patterns.missional.design/principles</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- How the eight became the ten -->
  <section class="section section-cream">
    <div class="container">
      <div style="margin-bottom: 3rem; max-width: 60ch;">
        <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.6;">From eight to ten</div>
        <h2>How the eight<br/>became the ten.</h2>
        <p class="lead" style="margin-top: 2rem;">
          Until October 2026 this framework had eight principles. Read against the calling and the deep dives, they lacked joy
          and craft, said nothing about speaking for God, treated the most vulnerable as a qualification rather than a
          starting point, and kept sacrifice as one item among eight. Here is where each went.
        </p>
      </div>
      <div class="grid grid-3">
        {became.map(([o, n]) => (
          <div style="padding: 1.5rem; background: var(--color-white); border: 1px solid var(--color-black);">
            <h4 style="margin-bottom: 0.5rem;">{o}</h4>
            <p style="font-size: 0.95rem; line-height: 1.5;">{n}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tensions -->
  <section class="section">
    <div class="container">
      <div style="margin-bottom: 3rem; max-width: 60ch;">
        <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.6;">Tensions</div>
        <h2>Three things<br/>worth holding.</h2>
        <p class="lead" style="margin-top: 2rem;">
          The ten overlap and sometimes pull apart. Some tensions must be held, not solved.
        </p>
      </div>
      <div class="grid grid-3">
        {tensions.map((t) => (
          <div style="padding: 2rem; background: var(--color-white); border: 1px solid var(--color-black);">
            <h4 style="margin-bottom: 1rem;">{t.title}</h4>
            <p style="font-size: 0.95rem; line-height: 1.5;">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Questions -->
  <section class="section section-ink">
    <div class="container">
      <div style="margin-bottom: 4rem; max-width: 60ch;">
        <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.6;">Six Questions</div>
        <h2>Diagnostic<br/>questions.</h2>
        <p class="lead" style="margin-top: 2rem; opacity: 0.85;">
          Use these to evaluate any feature, campaign, or design decision before it ships.
        </p>
      </div>
      <div>
        {questions.map((q, i) => (
          <div class="question">
            <div class="question-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="question-text">{q}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div style="max-width: 60ch;">
        <h2>Want to apply<br/>the framework?</h2>
        <p class="lead" style="margin-top: 2rem;">
          The framework is published openly as a resource for the field, and this version is a draft waiting for
          theological and pastoral review. If you build Bible, prayer, church or AI tools, or can help review it, I’d love
          to hear from you.
        </p>
        <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href={full} class="button">The ten in full</a>
          <EmailLink label="Get in touch" class="button" />
          <a href={`${base}/about`} class="button" style="background: transparent; color: var(--color-black); border: 1px solid var(--color-black);">About the author</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
