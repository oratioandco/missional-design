const places = [
  {
    num: '01',
    name: 'The Word',
    ask: 'What do we put in front of people as God’s word, or about it?',
    commitments: [
      {
        id: 'word-distinct',
        title: 'Keep the Word distinct, and teach it truly.',
        body: 'Every screen teaches, and those who teach are judged more strictly. Let readers always tell Scripture from our words, and our words from a machine’s: label every heading, note and answer, show the traditions where Christians differ, and keep a verse inside its passage.',
      },
      {
        id: 'speak-for-god',
        title: 'Never speak for God.',
        body: 'An app may quote, explain, pray the church’s prayers and point. It must never pronounce, promise or plead in God’s name, nor let a persona or a machine take the place of a person or of God. The Lord’s Prayer, a psalm or a written liturgy are the church’s words, offered as such; the persona that claims a relationship, and the promise that claims God’s answer, are not ours to make.',
      },
    ],
  },
  {
    num: '02',
    name: 'The person',
    ask: 'How do we receive the one holding the phone?',
    commitments: [
      {
        id: 'most-vulnerable',
        title: 'Design for the most vulnerable first.',
        body: 'Design first for the person most likely to be hurt: in crisis, grieving, abused, scrupulous, new to faith, hurt by a church, or, where an app serves them, a child. Help comes before features, verses or answers, and a way to a person is never behind an account, a limit or a paywall.',
      },
      {
        id: 'welcome',
        title: 'Welcome before you ask, and guard what is told in confidence.',
        body: '“Come and see.” Let people reach what they came for before asking anything, ask only for what serves them when it does, and treat what they tell you to pray as holy ground: never marketing data, never stored by default.',
      },
    ],
  },
  {
    num: '03',
    name: 'The practice',
    ask: 'What do we ask of their time, attention and money, and when do we stop?',
    commitments: [
      {
        id: 'feed-the-flock',
        title: 'Feed the flock, not on it.',
        body: 'Attention, time, devotion and money are entrusted, not harvested. Ask for them honestly, never through guilt, fear, urgency or a promise: no streak warnings marked urgent, no “we miss you” in a persona’s voice, no tier chosen for the giver.',
      },
      {
        id: 'enough',
        title: 'Make room for rest, and say when it is enough.',
        body: 'The Sabbath was made for people. A faithful product sometimes asks for less: it ends a session, keeps the night quiet, stops asking when the need is met, as Moses stopped the offerings when there was more than enough, and lets itself end when its work is done.',
      },
    ],
  },
  {
    num: '04',
    name: 'The people',
    ask: 'Where do we send them, and what do we claim to have grown?',
    commitments: [
      {
        id: 'send',
        title: 'Send people to God and to one another.',
        body: 'The app is a means, never the destination. Judge it by where people go when they close it: to Scripture, to prayer, to a church, a group, a friend. For someone isolated or hurt by a church, an online community may be the safe place; the bridge must lead somewhere chosen and safe.',
      },
      {
        id: 'growth',
        title: 'Plant and water; leave the growth to God.',
        body: 'Measure what serves the person and the task: usability, understanding, burden, harm. Never score a soul, never present usage as spiritual fruit, and never claim the fruit as yours.',
      },
    ],
  },
  {
    num: '05',
    name: 'The makers',
    ask: 'Who are we becoming as we build?',
    commitments: [
      {
        id: 'offering',
        title: 'Make it well, as an offering.',
        body: 'God filled Bezalel with skill for his work. Excellence, accessibility, beauty and care are how we love God and the person on the other side of the screen. “It’s for ministry” is never an excuse for careless work.',
      },
      {
        id: 'trembling',
        title: 'Hold it with joy and trembling, before God and others.',
        body: 'Rejoice in the work and take its weight: pray for the people who use it, invite those who can say no early, confess mistakes plainly, and tend what you release.',
      },
    ],
  },
];

const ways = [
  {
    label: 'Exploitative',
    praxis: '“I win, you lose”',
    body: 'The app takes the place. It borrows God’s voice to bring people back, sells access to prayer or a promise of blessing, keeps confidences as data and counts faith as usage. Name it. Refuse it.',
  },
  {
    label: 'Ethical',
    praxis: '“I win, you win”',
    body: 'The app keeps its place: safe, honest, accessible, lawful, careful with data and time. This is the floor and a gift of common grace, but it is not the goal.',
  },
  {
    label: 'Redemptive',
    praxis: '“I sacrifice, we win”',
    body: 'The app points beyond itself. It withholds claims it could make on attention, data, money and trust, tells the truth about itself, and is glad when people close it to go to God and to one another.',
  },
];

const tensions = [
  {
    title: 'Rhythm vs. pressure',
    body: 'Feed the flock, and make room for rest. A spiritual life needs rhythm, but the moment a rhythm becomes an enforced expectation it turns into pressure. Invite people into rhythm, and after silence ask once, then stop.',
  },
  {
    title: 'Community vs. starting alone',
    body: 'Send people to one another, and design for the most vulnerable first. Many begin alone, and some were hurt in a church. Build bridges that invite toward community rather than making it the price of entry.',
  },
  {
    title: 'Devotion vs. a voice that is not God’s',
    body: 'Never speak for God, and welcome before you ask. Offer the church’s prayers as the church’s, keep a way to a person first, and let no persona say it will pray.',
  },
];

const questions = [
  'Does this serve growth in faith, or only the usage numbers?',
  'Freedom or anxiety?',
  'Would we put our own name under this sentence, or are we borrowing God’s?',
  'Who is the most vulnerable person likely to use this today, and what will they see?',
  'If a user had a spiritually dry year, would they feel welcomed back or judged?',
  'If people developed deep communion with God and no longer needed the app, would we celebrate or mourn?',
];
