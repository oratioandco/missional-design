---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeDecisions from '../components/HomeDecisions.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang="en" title="Missional by Design" description="Design that serves life with God and one another. Practical frameworks, design patterns and theological reflection for churches, Christian organizations and product teams.">
  <!-- Hero -->
  <section class="hero contextual-home">
    <div class="hero-copy">
    <div class="hero-label">Tobias Treppmann · Oratio&Co</div>
    <h1>Design that serves life with God and one another.</h1>
    <p class="hero-subtitle">Our contexts keep changing. The churches, ministries and technologies we shape need continuing discernment: what really is good news here—and how can our work help people encounter and live it?</p>
    <p class="home-offer">Practical frameworks, design patterns and theological reflection for churches, Christian organizations and product teams.</p>
    <div class="home-actions"><a href="#in-practice" class="button">See the approach in practice →</a><a href={`${base}/missional-canvas/`} class="button home-secondary">Work with the canvas</a></div>
    </div><figure class="identity-hero-art contextual-photo"><img src={`${base}/assets/brand/silicon-window-v7.webp`} alt="An urban shared office seen through a window, with blue-silver silicon reflections" width="1536" height="1024" fetchpriority="high" /><figcaption>Generated editorial illustration · fictional people and place</figcaption></figure>
  </section>
  <HomeDecisions lang="en" />

  <!-- The Three Pillars -->
  <section class="section section-dark">
    <div class="container">
      <div style="margin-bottom: 4rem; max-width: 60ch;">
        <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.6;">The Work</div>
        <h2>Three tools.<br/>One approach.</h2>
      </div>

      <div class="grid grid-3">
        <a href={`${base}/missional-canvas/`} class="pillar-card">
          <div class="pillar-card-num">01</div>
          <h3>Ministry Model Canvas</h3>
          <p>
            A nine-block canvas for listening to your context, naming your missional identity and shaping your next steps. Start with the church version, or explore the nonprofit and business adaptations.
          </p>
          <div class="pillar-card-link">Explore the canvas →</div>
        </a>

        <a href={`${base}/framework`} class="pillar-card">
          <div class="pillar-card-num">02</div>
          <h3>Missional Product Design</h3>
          <p>
            Ten principles in five places and six diagnostic questions for redemptive design — a posture for building digital tools
            that honor what is most sacred in the people they serve, not extract their attention.
          </p>
          <div class="pillar-card-link">Read the framework →</div>
        </a>

        <a href={`${base}/blog`} class="pillar-card">
          <div class="pillar-card-num">03</div>
          <h3>Writing</h3>
          <p>
            Essays on missional design, digital formation, ministry innovation, and the surprising overlap between
            churches and startups. Questions and practical implications for the work we share.
          </p>
          <div class="pillar-card-link">Read the essays →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Need help applying it? → oratio.co -->
  <section class="section section-ink">
    <div class="container">
      <div class="grid grid-2" style="align-items: center; gap: 4rem;">
        <div>
          <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.75;">Need Help Applying It?</div>
          <h2>Bring in<br/>Oratio&amp;Co.</h2>
          <p class="lead" style="margin-top: 2rem; opacity: 0.9;">
            These frameworks were developed inside <strong>Oratio&amp;Co</strong> — a strategic design consultancy for
            churches, ministries, and faith-driven teams. If you want help applying them to your context, that's what
            Oratio&amp;Co does.
          </p>
          <div style="margin-top: 2.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="https://oratio.co" target="_blank" rel="noopener noreferrer" class="button" style="background: var(--color-white); color: var(--color-ink);">Visit oratio.co</a>
          </div>
        </div>
        <div style="padding: 2.5rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.2);">
          <div style="font-family: var(--font-display); font-weight: 900; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.75; margin-bottom: 1.5rem;">What Oratio&amp;Co does</div>
          <ul style="list-style: none; padding: 0; margin: 0; line-height: 2.2; font-weight: 400;">
            <li>→ Ministry consultation &amp; strategic design</li>
            <li>→ Canvas workshop facilitation</li>
            <li>→ Innovation training for ministry teams</li>
            <li>→ Online cohorts for practitioners</li>
            <li>→ Product design for faith-tech teams</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-card {
    display: block;
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    text-decoration: none;
    transition: all var(--transition);
    position: relative;
  }

  .pillar-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    opacity: 1;
  }

  .pillar-card-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
    opacity: 0.5;
  }

  .pillar-card h3 {
    margin-bottom: 1rem;
  }

  .pillar-card p {
    font-weight: 300;
    line-height: 1.5;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .pillar-card-link {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
