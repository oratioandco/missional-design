---
import Layout from '../../layouts/LibraryLayout.astro';
import assessments from '../../data/app-assessments.json';
import rubric from '../../data/app-design-rubric.json';
import {screens,appFor,organisationFor,flows,screenFor,dateLabel,articleTitle} from '../../lib/app-library';
export function getStaticPaths(){return screens.map(screen=>({params:{id:screen.id},props:{screen}}));}
const {screen:s}=Astro.props;const record=(assessments.apps as any[]).find(x=>x.app_id===s.app_id);const supports=record?Object.entries(record.dimensions).filter(([,f]:any)=>f.evidence?.some((e:any)=>e.url.includes(s.id))).map(([id,f]:any)=>({id,scope:f.scope,label:rubric.dimensions.find((d:any)=>d.id===id)!.label})):[];const app=appFor(s.app_id),org=organisationFor(s.organisation_id);const flow=flows.find(f=>f.id===s.flow_id);const pos=flow?flow.screen_ids.indexOf(s.id):-1;const previous=flow&&pos>0?screenFor(flow.screen_ids[pos-1]):null;const next=flow&&pos<flow.screen_ids.length-1?screenFor(flow.screen_ids[pos+1]):null;
---
<Layout title={s.screen_name+' — '+app.name} description={s.caption} active="screens" indexable><span hidden data-pagefind-meta="record_id">{'screen:'+s.id}</span><span hidden data-pagefind-filter="kind">screen</span><span hidden data-pagefind-filter="app">{s.app_id}</span><span hidden data-pagefind-filter="screen_type">{s.screen_type}</span>{['components','tags','tasks','states'].map(key=>s[key].map(value=><span hidden data-pagefind-filter={key}>{value}</span>))}<header class="lib-screen-heading"><a class="lib-back" href="/screens/">All screenshots</a><h1 data-pagefind-meta="title">{s.screen_name}</h1><p><a href={app.url}>{app.name}</a> · {dateLabel(s.captured)} · Version {s.version}</p></header><div class="lib-screen-detail"><figure><a href={s.image} aria-label="Open original-size screenshot"><img src={s.image} width="1320" height="2868" alt={s.screen_name} loading="eager" /></a><figcaption>App interface screenshot · {app.name}. Original pixels preserved.</figcaption></figure><div class="lib-screen-notes"><h2>What this shows</h2><p data-pagefind-meta="description">{s.caption}</p><h2>Capture context</h2><p>{s.context}</p><p class="lib-note">Captured for interface research. Screen behaviour may change between app versions.</p><details class="lib-transcript"><summary>Selected text visible in this screen</summary><p class="lib-note">Interface labels transcribed during review.</p><p>{s.text}</p></details>{s.article_slugs.length>0&&<section><h2>Explore the design questions</h2><ul class="lib-link-list">{s.article_slugs.map(slug=><li><a href={'/patterns/'+slug+'/'}>{articleTitle(slug)}</a></li>)}</ul></section>}{supports.length>0&&<section><h2>Evidence for a design observation</h2><ul class="lib-link-list">{supports.map(x=><li><a href={app.url+'#finding-'+x.id}>{x.label}</a><p>{x.scope}</p></li>)}</ul></section>}<h2>Explore this screen</h2><dl class="lib-dl"><div><dt>Screen type</dt><dd><a href={'/screens/?facet=screen_type&category='+encodeURIComponent(s.screen_type)}>{s.screen_type}</a></dd></div>{['components','tags','tasks','states'].map(key=><div><dt>{{components:'Components',tags:'Patterns / features',tasks:'User tasks',states:'Interface states'}[key]}</dt><dd class="lib-chips">{!s[key].length&&<span class="lib-muted">Not specified</span>}{s[key].map(value=><a href={'/screens/?facet='+key+'&category='+encodeURIComponent(value)}>{value}</a>)}</dd></div>)}</dl><details><summary>Component details</summary><p>{(s.component_details || s.components).join(' · ')}</p></details><details class="lib-classification-details"><summary>Original descriptive labels</summary><p class="lib-note">Browsing uses consistent groups. The original reviewed labels stay searchable; they can describe settings, context or capture details rather than a user task or interface state.</p><dl class="lib-dl"><div><dt>Screen description</dt><dd>{s.screen_type_detail||s.screen_type}</dd></div><div><dt>Task descriptions</dt><dd>{(s.task_details||s.tasks).join(' · ')||'Not recorded'}</dd></div><div><dt>State and context descriptions</dt><dd>{(s.state_details||s.states).join(' · ')||'Not recorded'}</dd></div><div><dt>Feature descriptions</dt><dd>{(s.tag_details||s.tags).join(' · ')||'Not recorded'}</dd></div></dl></details><div class="lib-profile-links"><a href={app.url}>App profile: {app.name}</a><a href={'/screens/?app='+encodeURIComponent(s.app_id)}>More screens from {app.name}</a><a href={org.url}>Publisher: {org.name}</a></div>{flow&&<section><h2>In a captured sequence</h2><p><a href={flow.url}>{flow.title}</a></p><p class="lib-note">{flow.coverage}</p><nav class="lib-sequence-nav" aria-label="Screens in this sequence">{previous&&<a href={previous.url}>Previous screen</a>}{next&&<a href={next.url}>Next screen</a>}</nav></section>}</div></div></Layout>
