---
import Layout from '../../layouts/LibraryLayout.astro';
import ScreenGrid from '../../components/library/ScreenGrid.astro';
import {screens,apps,organisations} from '../../lib/app-library';
const facets={screen_type:'Screen type',components:'Component',tags:'Pattern / feature',tasks:'User task',states:'Interface state'};
---
<Layout title="Real Bible and faith app screens" description="Browse real app screenshots by screen type, component, task and state, with links to the design questions they raise." active="screens"><header class="lib-intro"><h1>See the decisions<br/>on the screen.</h1><p>Real interfaces from Bible and faith apps. Explore a component, follow a captured sequence or find the app behind an example.</p><p class="lib-note">Beta · a reviewed selection, growing over time. Screenshots show a particular version and moment, rather than exhaustive app coverage.</p></header><div id="public-library" class="lib-browser"><aside class="lib-sidebar"><details open><summary>Browse screens</summary><label for="facet-kind">Browse by</label><select id="facet-kind">{Object.entries(facets).map(([value,name])=><option value={value}>{name}</option>)}</select><p class="lib-note" id="facet-help">The purpose of the screen or surface.</p><label class="sr" for="facet-search">Find a category</label><input id="facet-search" type="search" placeholder="Find a category"/><nav id="facet-list" aria-label="Screenshot categories"></nav></details></aside><div class="lib-results-pane"><form id="lib-search-form" class="lib-quick-search" role="search"><label class="sr" for="lib-query">Search the app library</label><input type="search" id="lib-query" name="q" placeholder="Search by app, screen or visible text…"/><button type="submit">Search</button></form><div class="lib-filter-row"><label>Show<select id="lib-kind"><option value="screen">Screens</option><option value="app">Apps</option><option value="organisation">Organisations</option><option value="flow">Flows</option><option value="all">Everything</option></select></label><label>App<select id="lib-app"><option value="">All apps</option>{apps.map(a=><option value={a.id}>{a.name}</option>)}</select></label><button id="lib-reset" type="button">Clear filters</button></div><div class="lib-section-heading"><h2 id="lib-result-title">Screens</h2><p id="lib-result-count" role="status">{screens.length} screenshots</p></div><p id="lib-search-message" role="status" class="lib-note"></p><div id="lib-scope" class="lib-note lib-scope" hidden></div><div id="lib-results"><ScreenGrid screens={screens}/></div><nav id="lib-pagination" class="lib-pagination" aria-label="Search result pages" hidden></nav><noscript><p class="lib-note">All reviewed screenshots remain available here. Enable JavaScript for search and category filters, or browse the app and organisation pages.</p></noscript></div></div><script is:inline type="module" src="/assets/app-library/search.js"></script></Layout>
