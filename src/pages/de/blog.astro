---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang="de" title="Texte">
  <section class="hero text-hero">
    <div class="hero-label">Missional by Design · Texte</div>
    <h1>Texte.</h1>
    <p class="hero-subtitle">
      Essays über missionale Gestaltung, digitale Prägung, Innovation in der Gemeindearbeit und die überraschende Überschneidung
      zwischen Gemeinden und Gründungen. Fragen und praktische Konsequenzen für unsere gemeinsame Arbeit.
    </p>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 900px;">
        <a href={`${base}/de/blog/which-rock/`} class="post-card">
          <div class="post-card-meta"><span class="post-card-tag">Essay · 2026</span></div>
          <h2 class="post-card-title">Auf welchen Fels bauen wir?</h2>
          <p class="post-card-excerpt">KI, geistliche Prägung und unsere Verantwortung vor Gott, der Gemeinde und unseren Mitmenschen. Was bedeutet gute Arbeit, wenn Menschen ein Produkt weniger brauchen?</p>
          <div class="post-card-read">Essay lesen →</div>
        </a>

        <!-- Veröffentlichter Beitrag -->
        <a href={`${base}/de/blog/churches-and-startups`} class="post-card">
          <div class="post-card-meta">
            <span class="post-card-tag">Essay</span>
            <span class="post-card-date">2026</span>
          </div>
          <h2 class="post-card-title">Warum Gemeinden und junge Unternehmen mehr gemeinsam haben, als man denkt.</h2>
          <p class="post-card-excerpt">
            Große Vision, knappe Mittel, fließender Kontext. Die überraschende Überschneidung zweier scheinbar
            gegensätzlicher Welten — und was beide voneinander lernen können.
          </p>
          <div class="post-card-read">Essay lesen →</div>
        </a>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-card {
    display: block;
    padding: 3rem 0;
    border-top: 1px solid var(--rule-strong);
    text-decoration: none;
    color: var(--color-black);
    transition: opacity var(--transition);
  }
  .post-card:last-of-type {
    border-bottom: 1px solid var(--rule-strong);
  }
  .post-card:hover {
    border-top-color: var(--color-black);
  }
  .post-card-placeholder {
    opacity: 0.45;
    pointer-events: none;
  }
  .post-card-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font: 500 var(--t-micro)/1.3 var(--sans);
    letter-spacing: 0.05em;
    color: var(--faint);
  }
  .post-card-tag,
  .post-card-date {
    color: var(--faint);
  }
  .post-card-title {
    font: 400 clamp(32px, 3.6vw, 52px)/1.04 var(--serif);
    letter-spacing: -0.014em;
    margin-bottom: 1.5rem;
    max-width: 22ch;
  }
  .post-card-excerpt {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: 1.25rem;
  }
  .post-card-read {
    font: 500 var(--t-small)/1.4 var(--sans);
    letter-spacing: 0.01em;
  }
</style>
