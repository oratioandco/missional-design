---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeDecisions from '../../components/HomeDecisions.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  lang="de"
  title="Missional by Design"
  description="Gestaltung, die dem Leben mit Gott und miteinander dient. Praktische Werkzeuge, Gestaltungsmuster und theologische Reflexion für Gemeinden, christliche Organisationen und Produktteams."
>
  <!-- Hero -->
  <section class="hero contextual-home">
    <div class="hero-copy">
    <div class="hero-label">Tobias Treppmann · Oratio&Co</div>
    <h1>Gestaltung, die dem Leben mit Gott und miteinander dient.</h1>
    <p class="hero-subtitle">Unsere Kontexte verändern sich laufend. Gemeinden, Initiativen und Technologien brauchen deshalb immer wieder neue Aufmerksamkeit: Was ist hier wirklich die gute Nachricht – und wie kann unsere Arbeit ihr Gestalt geben?</p>
    <p class="home-offer">Praktische Werkzeuge, Gestaltungsmuster und theologische Reflexion für Gemeinden, christliche Organisationen und Produktteams.</p>
    <div class="home-actions"><a href="#in-practice" class="button">Den Ansatz kennenlernen →</a><a href={`${base}/missional-canvas/`} class="button home-secondary">Mit dem Canvas arbeiten</a></div>
    </div><figure class="identity-hero-art contextual-photo"><img src={`${base}/assets/brand/silicon-window-v3.webp`} alt="Ein urbanes Gemeinschaftsbüro hinter einem Fenster mit blau-silbernen Siliziumreflexionen" width="1536" height="1024" fetchpriority="high" /><figcaption>Generierte redaktionelle Illustration · fiktive Menschen und Orte</figcaption></figure>
  </section>
  <HomeDecisions lang="de" />

  <!-- The Three Pillars -->
  <section class="section section-dark">
    <div class="container">
      <div style="margin-bottom: 4rem; max-width: 60ch;">
        <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.6;">Die Arbeit</div>
        <h2>Drei Werkzeuge.<br/>Ein Ansatz.</h2>
      </div>

      <div class="grid grid-3">
        <a href={`${base}/missional-canvas/`} class="pillar-card">
          <div class="pillar-card-num">01</div>
          <h3>Ministry Model Canvas</h3>
          <p>
            Ein Canvas mit neun Feldern: den Kontext verstehen, die missionale Identität klären und nächste Schritte gestalten. Mit einer Gemeindeversion und Entwürfen für gemeinnützige Organisationen und Unternehmen.
          </p>
          <div class="pillar-card-link">Canvas erkunden →</div>
        </a>

        <a href={`${base}/de/framework`} class="pillar-card">
          <div class="pillar-card-num">02</div>
          <h3>Missionale Produktgestaltung</h3>
          <p>
            Zehn Prinzipien an fünf Orten und sechs Prüffragen für missionale Gestaltung — eine Haltung für die Entwicklung
            digitaler Werkzeuge, die das Heiligste der Menschen achten, statt ihre Aufmerksamkeit abzuschöpfen.
          </p>
          <div class="pillar-card-link">Rahmenwerk lesen →</div>
        </a>

        <a href={`${base}/de/blog`} class="pillar-card">
          <div class="pillar-card-num">03</div>
          <h3>Texte</h3>
          <p>
            Essays über missionale Gestaltung, digitale Prägung, Innovation in der Gemeindearbeit und die überraschende
            Überschneidung zwischen Gemeinden und Gründungen. Fragen und praktische Konsequenzen für unsere gemeinsame Arbeit.
          </p>
          <div class="pillar-card-link">Essays lesen →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Need help applying it? → oratio.co -->
  <section class="section section-ink">
    <div class="container">
      <div class="grid grid-2" style="align-items: center; gap: 4rem;">
        <div>
          <div style="font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; opacity: 0.75;">Brauchst du Hilfe?</div>
          <h2>Hol dir<br/>Oratio&amp;Co an den Tisch.</h2>
          <p class="lead" style="margin-top: 2rem; opacity: 0.9;">
            Diese Rahmenwerke sind bei <strong>Oratio&amp;Co</strong> entstanden — einer Agentur für strategische Gestaltung, die mit Gemeinden, kirchlichen Initiativen und glaubensbasierten Teams arbeitet. Brauchst du Hilfe bei der Anwendung? Dafür ist Oratio&amp;Co da.
          </p>
          <div style="margin-top: 2.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="https://oratio.co" target="_blank" rel="noopener noreferrer" class="button" style="background: var(--color-white); color: var(--color-ink);">Besuche oratio.co</a>
          </div>
        </div>
        <div style="padding: 2.5rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.2);">
          <div style="font-family: var(--font-display); font-weight: 900; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.75; margin-bottom: 1.5rem;">Was Oratio&amp;Co macht</div>
          <ul style="list-style: none; padding: 0; margin: 0; line-height: 2.2; font-weight: 400;">
            <li>→ Gemeindeberatung &amp; strategische Gestaltung</li>
            <li>→ Moderation von Canvas-Arbeitstreffen</li>
            <li>→ Innovationstraining für Teams</li>
            <li>→ Lerngruppen für Praktiker (online)</li>
            <li>→ Produktgestaltung für glaubensbasierte Technologie-Teams</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-card {
    display: block;
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    text-decoration: none;
    transition: all var(--transition);
    position: relative;
  }

  .pillar-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    opacity: 1;
  }

  .pillar-card-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
    opacity: 0.5;
  }

  .pillar-card h3 {
    margin-bottom: 1rem;
  }

  .pillar-card p {
    font-weight: 300;
    line-height: 1.5;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .pillar-card-link {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
