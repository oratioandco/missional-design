---
import data from '../data/missional-canvases.json';
const short=['Audience','Connection','Identity','Relationships','Activities','Channels','Resources','Budget','Assessment'];
---
<section id="canvas-workbook" class="workbook" hidden aria-labelledby="workbook-title">
 <header class="workbook-head"><p class="eyebrow">Your working canvas</p><h2 id="workbook-title">Make space for discernment.</h2><p>Start anywhere. Leave questions open. Return as your context changes.</p></header>
 <p class="local-note">Your answers stay in this browser on this device. Download an editable copy to keep a backup or continue elsewhere. Clearing browser data removes local drafts.</p>
 <p id="draft-status" class="draft-status" role="status" aria-live="polite"></p>
 <div class="restore-actions"><button type="button" id="import-canvas">Open an editable copy</button><input id="canvas-file" type="file" accept="application/json,.json" hidden /><button type="button" id="replace-local" hidden>Replace unreadable local drafts with this draft</button></div>
 <fieldset class="project-fields"><legend>The people and place behind this canvas</legend><label>Project or organization<input name="project" maxlength="180" autocomplete="organization" /></label><label>Team or participants<input name="team" maxlength="300" autocomplete="off" /></label><label class="context-field">Our context<textarea name="context" maxlength="3000" rows="2" placeholder="The place, community or situation we are discerning together"></textarea></label><label>Revisit this context on<input name="reviewDate" type="date" /></label></fieldset>
 <div class="writing-layout"><nav class="writing-nav" aria-label="Writing sections"><p id="writing-progress">0 of 9 sections started</p>{data.variants[0].blocks.map((b,i)=><button type="button" data-writing-step={i}><span>{b.number}</span><span>{short[i]}</span><span class="section-state" aria-hidden="true"></span></button>)}<button type="button" data-writing-step="9"><span>↗</span><span>Review &amp; download</span></button></nav>
 <div class="writing-main">{data.variants.map(v=><div data-writing-variant={v.id} hidden>{v.blocks.map((b,i)=><section data-answer-step={i} hidden aria-labelledby={`write-${v.id}-${b.number}`}><p class="eyebrow">Section {b.number} of 09</p><h3 id={`write-${v.id}-${b.number}`} tabindex="-1">{b.title}</h3>{b.number==='03' && <p class="identity-invitation">Let the people affected by your work help you discern what good news could mean here.</p>}{b.questions.map((q,j)=><label class="answer-label" for={`answer-${v.id}-${b.number}-${j}`}>{q}<textarea id={`answer-${v.id}-${b.number}-${j}`} data-block={b.number} data-question={j} maxlength="20000" rows={b.number==='03' && j===0?6:4}></textarea></label>)}</section>)}</div>)}
 <section id="canvas-review" hidden aria-labelledby="review-title"><p class="eyebrow">A working expression, open to revision</p><h3 id="review-title" tabindex="-1">Take it into the conversation.</h3><p>The PDF is a single A3 landscape canvas, with each guiding question and your answer inside its corresponding block. Text adjusts to fit; if a block is too full to stay readable, we’ll ask you to shorten it. Download an editable copy so you can return to the work later.</p><p id="review-count"></p><div class="download-actions"><button type="button" id="download-canvas-pdf" class="primary-action">Download filled PDF</button><button type="button" id="download-canvas-json">Download editable copy</button><button type="button" id="print-canvas">Print / Save as PDF</button></div><p class="field-hint">No account or upload required. The editable copy is a file you can reopen here.</p><p id="export-status" class="draft-status" role="status" aria-live="polite"></p><div id="fit-actions"></div><div id="review-answers"></div><details class="clear-draft"><summary>Start this version again</summary><p>This removes this version’s answers from this browser. Other canvas versions are kept.</p><button type="button" id="clear-canvas">Clear this draft</button></details></section>
 <div class="step-actions"><button type="button" id="previous-section">Previous section</button><button type="button" id="next-section" class="primary-action">Next section</button></div>
 </div></div>
 <noscript>This writing tool needs JavaScript. You can still read the questions and download the blank printable canvases above.</noscript>
</section>
<style>
[hidden]{display:none!important}
.workbook{margin-top:32px;border-top:1px solid #c6c0b3;padding-top:32px}.workbook[hidden]{display:none}.workbook-head h2{font:400 clamp(36px,4vw,52px)/1.1 var(--mbd-editorial);margin:12px 0}.eyebrow{font-size:12px;letter-spacing:.1em;text-transform:uppercase}.local-note{font-size:14px;line-height:1.6;color:#55524b;max-width:80ch;margin:20px 0 10px}.draft-status{font-size:14px;min-height:1.6em;margin:8px 0}.draft-status[data-error=true]{color:#9b251c}.restore-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px}button{font:inherit;font-size:14px;line-height:1.4;padding:12px 18px;background:transparent;color:#151412;border:1px solid #a29c90;cursor:pointer;text-align:left}button:hover{background:#f3ead3}button:disabled{opacity:.55;cursor:wait}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #8a5a00;outline-offset:3px}.primary-action{background:#151412;color:#fff;border-color:#151412}.primary-action:hover{background:#35322b}.project-fields{border:1px solid #c6c0b3;padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px;min-width:0}.project-fields legend{padding:0 8px;font-size:14px}.project-fields label{font-size:14px;display:flex;flex-direction:column;gap:8px}.context-field{grid-column:1/-1}input,textarea{display:block;width:100%;border:1px solid #a29c90;border-radius:0;background:#fff;color:#151412;font:inherit;font-size:16px;line-height:1.6;padding:12px;min-width:0}textarea{resize:vertical}.writing-layout{display:grid;grid-template-columns:210px minmax(0,1fr);gap:40px;align-items:start}.writing-nav{position:sticky;top:100px}.writing-nav p{font-size:13px;margin-bottom:14px}.writing-nav button{display:flex;align-items:center;gap:10px;width:100%;border:0;border-top:1px solid #d6d2c8;padding:13px 8px}.writing-nav button[aria-current=step]{background:#f3ead3;box-shadow:inset 3px 0 #8a5a00}.writing-nav button>span:first-child{color:#686257;font-size:12px}.section-state{margin-left:auto}.section-state[data-started=true]::after{content:'•';color:#70500f}.writing-main{min-width:0;max-width:820px}.writing-main h3{font:400 clamp(34px,4vw,48px)/1.12 var(--mbd-editorial);margin:12px 0 28px}.identity-invitation{background:#f3ead3;padding:18px;margin-bottom:28px;line-height:1.6}.answer-label{display:block;font-size:17px;line-height:1.6;margin-bottom:28px}.answer-label textarea{margin-top:10px}.field-hint{display:block;font-size:13px;line-height:1.6;color:#55524b;margin-top:8px}.step-actions{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #d6d2c8;margin-top:25px;padding-top:20px}.step-actions button{max-width:50%}.download-actions{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0 12px}.clear-draft{margin-top:40px;font-size:14px}.clear-draft summary{cursor:pointer}.clear-draft p{margin:12px 0}.writing-main :global(.review-block){padding:22px 0;border-bottom:1px solid #d6d2c8}.writing-main :global(.review-block h4){font-size:18px;margin-bottom:12px}.writing-main :global(.review-block dt){font-size:14px;color:#55524b;margin:16px 0 8px}.writing-main :global(.review-block dd){white-space:pre-wrap;overflow-wrap:anywhere;font-size:16px;line-height:1.65;margin:0}.writing-main :global(.review-block a){display:inline-block;margin-top:12px}#canvas-review>p{line-height:1.65;margin:16px 0}#canvas-review[hidden],[data-answer-step][hidden],[data-writing-variant][hidden]{display:none}
@media(max-width:760px){.writing-layout{grid-template-columns:1fr;gap:28px}.writing-nav{position:static;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#d6d2c8;border:1px solid #d6d2c8}.writing-nav p{grid-column:1/-1;background:#fbfaf7;margin:0;padding:12px}.writing-nav button{padding:12px 7px;background:#fff;font-size:12px;min-height:56px;gap:5px;border:0}.writing-nav button:last-child{grid-column:1/-1;min-height:44px}.project-fields{grid-template-columns:1fr;padding:18px}.context-field{grid-column:auto}.answer-label{font-size:16px}.step-actions button{padding:12px}.workbook{scroll-margin-top:30px}}@media print{.workbook{display:none!important}}
</style>
