---
import ScreenGrid from './ScreenGrid.astro';
const {app,screens}=Astro.props;
---
<section class="lib-section lib-profile-captures" id="research-captures">
 <div class="lib-section-heading"><h2>Research screenshots</h2><span>{screens.length} reviewed screen{screens.length===1?'':'s'}</span></div>
 {screens.length>0?<><p class="lib-note">Captured app states, distinct from the publisher’s promotional images. Dates and versions belong to each screen; this is not a complete app walkthrough.</p><div class="lib-capture-preview"><ScreenGrid screens={screens.slice(0,2)}/></div>{screens.length>2&&<details class="lib-captures-more"><summary><span class="lib-when-closed">Show all {screens.length} research screenshots</span><span class="lib-when-open">Show fewer research screenshots</span></summary><ScreenGrid screens={screens.slice(2)}/></details>}<a class="lib-gallery-link" href={'/screens/?app='+encodeURIComponent(app.id)}>Browse all {screens.length} screenshots with filters</a></>:<p class="lib-muted">No research captures for this app are published yet. Publisher images are available below.</p>}
</section>
<script>
 const section=document.querySelector('.lib-profile-captures');
 const preview=section?.querySelector('.lib-capture-preview .lib-grid');
 const disclosure=section?.querySelector<HTMLDetailsElement>('.lib-captures-more');
 const remaining=disclosure?.querySelector('.lib-grid');
 if(preview&&remaining&&disclosure){
  const extras=[...remaining.children].slice(0,2);const wide=matchMedia('(min-width:701px)');
  const adapt=()=>{
   const focused=document.activeElement;
   const movingFocus=focused instanceof HTMLElement&&extras.some(card=>card===focused||card.contains(focused));
   if(!wide.matches&&movingFocus)disclosure.open=true;
   if(wide.matches)extras.forEach(card=>preview.append(card));
   else [...extras].reverse().forEach(card=>remaining.prepend(card));
   disclosure.hidden=remaining.children.length===0;
   if(movingFocus)focused.focus({preventScroll:true});
   else if(disclosure.hidden&&focused instanceof HTMLElement&&disclosure.contains(focused)){const last=extras.at(-1);if(last instanceof HTMLElement)last.focus({preventScroll:true});}
  };
  adapt();wide.addEventListener('change',adapt);
 }
</script>
