---
import data from '../../data/app-assessments.json';
import {dateLabel,screensFor} from '../../lib/app-library';
const {app,part='all'}=Astro.props;const a=data.apps.find(x=>x.app_id===app.id);
const dimensions=[['money_access','Money and access'],['attention_agency','Attention and agency'],['truth_authority','Truth and spiritual authority'],['privacy_dignity','Privacy and dignity'],['formation_relationships','Formation and relationships'],['care_inclusion','Care and inclusion'],['craft_repair','Craft and repair'],['stewardship_accountability','Stewardship and accountability']];
const labels:Record<string,string>={concern_evidenced:'Concern evidenced',ethical_baseline_observed:'Ethical safeguard observed',redemptive_candidate:'Redemptive candidate',redemptive_practice_evidenced:'Redemptive practice evidenced',mixed:'Mixed',not_assessed:'Not assessed',not_applicable:'Not applicable'};
const features=a?.ingredients.filter(i=>i.kind==='feature')||[];const patterns=a?.ingredients.filter(i=>i.kind==='pattern')||[];const shots=screensFor(app.id);const assessed=a?Object.values(a.dimensions).filter(d=>!['not_assessed','not_applicable'].includes(d.status)).length:0;
---
{a&&part!=='reviews'&&<section class="lib-section lib-nutrition" id="ingredients" aria-labelledby="nutrition-title">
 <div class="lib-nutrition-heading"><h2 id="nutrition-title">Ingredients &amp; assessment</h2><p>An app nutrition label · Evidence checked {dateLabel(a.checked)}</p></div>
 <div class="lib-nutrition-columns">
  <div class="lib-nutrition-content"><h3>Observed ingredients</h3><p class="lib-note">What is visible in reviewed screens. Missing entries mean unknown, not absent.</p>
   <dl class="lib-nutrition-list"><div><dt>Features</dt><dd>{features.length?features.map((i,n)=><Fragment>{n>0?', ':''}{i.label}</Fragment>):'Not separately catalogued yet.'}</dd></div><div><dt>Patterns</dt><dd>{patterns.length?<>{patterns.slice(0,4).map((i,n)=><Fragment>{n>0?', ':''}<a href={'/patterns/'+i.pattern_slug+'/'}>{i.label}</a></Fragment>)}{patterns.length>4&&<span class="lib-note">; {patterns.length-4} more in the evidence below.</span>}</>:'Not yet verified from publishable captures.'}</dd></div><div><dt>Capture evidence</dt><dd><a href="#research-captures">{shots.length} reviewed screenshot{shots.length===1?'':'s'}</a><span class="lib-note"> · Selected states, not a complete audit.</span></dd></div></dl>
  </div>
  <div class="lib-dimension-profile" id="assessment"><h3>Design assessment</h3><p class="lib-note">{assessed?`${assessed} scoped observation${assessed===1?'':'s'}; other dimensions remain open.`:'Assessment not yet completed. The rows below show what is still unknown.'}</p>
   <dl class="lib-dimension-list">{dimensions.map(([id,name])=>{const d=a.dimensions[id];return <div class:list={['lib-dimension','lib-dimension-row',{'lib-dimension-observed':!!d}]}><dt>{name}</dt><dd>{d?labels[d.status]||d.status:'Not assessed'}</dd>{d&&<dd class="lib-dimension-context"><p class="lib-dimension-scope">{d.scope}</p><details class="lib-dimension-reason"><summary>Reasoning and limits</summary><p>{d.reason}</p><p class="lib-note">{d.limits}</p></details></dd>}</div>;})}</dl>
  </div>
 </div>
 {a.ingredients.length>0&&<details class="lib-ingredient-evidence" id="ingredient-evidence"><summary>View all {a.ingredients.length} ingredients and supporting captures</summary><dl class="lib-ingredients">{a.ingredients.map(i=><div><dt>{i.kind==='pattern'?<a href={'/patterns/'+i.pattern_slug+'/'}>{i.label}</a>:i.label}<small>{i.kind==='feature'?'Feature':'Pattern'} · observed in a capture</small></dt><dd><p>{i.implementation}</p><div class="lib-evidence-links">{i.evidence.map((e,n)=><a href={e.url}>View capture{i.evidence.length>1?' '+(n+1):''}</a>)}</div></dd></div>)}</dl><p class="lib-note">A pattern link identifies a design question illustrated by the capture. It does not mean every option in its spectrum is implemented.</p></details>}
 <p class="lib-nutrition-footnote">No overall app score. A paid plan or free access does not determine the assessment; unassessed is not a pass. <a href="/apps/assessment/">Read the method</a>.</p>
</section>}
{a&&part!=='label'&&<section class="lib-section" id="user-response"><h2>What reviewers report</h2><p>Store reviews offer useful questions to investigate. These retrieved samples are self-selected, vary by platform and do not establish the experience of every user.</p><details class="lib-source-details lib-review-details"><summary>Review samples, reading and sources</summary>{a.review_note&&<div class="lib-review-note"><h3>Illustrative reading</h3><p>{a.review_note.summary}</p><p class="lib-note">Based on {a.review_note.examples_reviewed} selected review excerpts, which may be historical; not a full thematic analysis. {a.review_note.source_urls.map((url,n)=><Fragment><a href={url} target="_blank" rel="noreferrer">Review source{a.review_note!.source_urls.length>1?' '+(n+1):''}</a>{' '}</Fragment>)}</p></div>}<dl class="lib-ingredients lib-review-samples">{a.play.map(s=><div><dt>Google Play<small>{s.language==='en'?'English':'German'} / {s.country.toUpperCase()} requested</small></dt><dd>{s.n>0?<><p><strong>{s.n} written reviews</strong> within the 180 days ending 25 October 2026.</p><p class="lib-star-counts"><span>4–5 stars: {Number(s.histogram['4'])+Number(s.histogram['5'])}</span><span>3 stars: {s.histogram['3']}</span><span>1–2 stars: {Number(s.histogram['1'])+Number(s.histogram['2'])}</span></p>{s.n<20&&<p class="lib-note">Small sample: fewer than 20 recent reviews.</p>}</>:<p>No written reviews in this retrieved sample fall within the recent window.</p>}<a href={s.url} target="_blank" rel="noreferrer">View Google Play listing</a></dd></div>)}{!a.play.length&&<div><dt>Google Play</dt><dd>Matched written-review sample unavailable. No sentiment conclusion drawn.</dd></div>}<div><dt>Apple App Store<small>Public review page · default order</small></dt><dd>{a.apple.n?<><p>{a.apple.n} selected excerpts returned; these may be older and are not a recent or random sample.</p><p class="lib-note">Returned dates: {dateLabel(a.apple.oldest!)} – {dateLabel(a.apple.newest!)}.</p></>:<p>No excerpts returned by this source. This does not mean there are no reviews.</p>}{a.apple.url&&<a href={a.apple.url} target="_blank" rel="noreferrer">View Apple reviews</a>}</dd></div></dl><p class="lib-note">Collected {dateLabel(a.checked)}. Up to 50 newest Play reviews per requested language/storefront before the date filter. Requested locale does not establish residence; streams may overlap and must not be added together. Star counts describe ratings, not text sentiment or ethical quality. <a href="/apps/assessment/#reviews">Methods and limitations</a>.</p></details></section>}
