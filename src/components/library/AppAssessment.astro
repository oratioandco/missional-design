---
import data from '../../data/app-assessments.json';
import contextData from '../../data/app-profile-context.json';
import {dateLabel} from '../../lib/app-library';
import AppDesignFindings from './AppDesignFindings.astro';
import AppIngredients from './AppIngredients.astro';
const {app,part='all'}=Astro.props;const a=data.apps.find(x=>x.app_id===app.id);const hasContext=contextData.apps.some(x=>x.app_id===app.id);
---
{(part==='all'||part==='label'||part==='findings')&&<AppDesignFindings app={app}/>}{(part==='all'||part==='notes')&&<AppDesignFindings app={app} part="notes"/>}{(part==='all'||part==='label'||part==='ingredients')&&<AppIngredients app={app}/>}
{a&&(part==='all'||part==='reviews')&&<section class="lib-section" id="user-response"><h2>Store reviews</h2><p>Store reviews offer useful questions to investigate. These retrieved samples are self-selected, vary by platform and do not establish the experience of every user.</p>{a.review_note&&!hasContext&&<div class="lib-review-note"><h3>Illustrative reading</h3><p>{a.review_note.summary}</p><p class="lib-note">Based on {a.review_note.examples_reviewed} selected review excerpts, which may be historical; not a full thematic analysis. {a.review_note.source_urls.map((url,n)=><Fragment><a href={url} target="_blank" rel="noreferrer">Review source{a.review_note!.source_urls.length>1?' '+(n+1):''}</a>{' '}</Fragment>)}</p></div>}<details class="lib-source-details lib-review-details"><summary>Review samples, reading and sources</summary><dl class="lib-ingredients lib-review-samples">{a.play.map(s=><div><dt>Google Play<small>{s.language==='en'?'English':'German'} / {s.country.toUpperCase()} requested</small></dt><dd>{s.n>0?<><p><strong>{s.n} written reviews</strong> within the 180 days ending 25 October 2026.</p><p class="lib-star-counts"><span>4–5 stars: {Number(s.histogram['4'])+Number(s.histogram['5'])}</span><span>3 stars: {s.histogram['3']}</span><span>1–2 stars: {Number(s.histogram['1'])+Number(s.histogram['2'])}</span></p>{s.n<20&&<p class="lib-note">Small sample: fewer than 20 recent reviews.</p>}</>:<p>No written reviews in this retrieved sample fall within the recent window.</p>}<a href={s.url} target="_blank" rel="noreferrer">View Google Play listing</a></dd></div>)}{!a.play.length&&<div><dt>Google Play</dt><dd>Matched written-review sample unavailable. No sentiment conclusion drawn.</dd></div>}<div><dt>Apple App Store<small>Public review page · default order</small></dt><dd>{a.apple.n?<><p>{a.apple.n} selected excerpts returned; these may be older and are not a recent or random sample.</p><p class="lib-note">Returned dates: {dateLabel(a.apple.oldest!)} – {dateLabel(a.apple.newest!)}.</p></>:<p>No excerpts returned by this source. This does not mean there are no reviews.</p>}{a.apple.url&&<a href={a.apple.url} target="_blank" rel="noreferrer">View Apple reviews</a>}</dd></div></dl><p class="lib-note">Collected {dateLabel(a.checked)}. Up to 50 newest Play reviews per requested language/storefront before the date filter. Requested locale does not establish residence; streams may overlap and must not be added together. Star counts describe ratings, not text sentiment or ethical quality. <a href="/apps/assessment/#reviews">Methods and limitations</a>.</p></details></section>}
