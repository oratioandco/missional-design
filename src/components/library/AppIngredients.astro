---
import data from '../../data/app-assessments.json';
const {app}=Astro.props;const a=data.apps.find(x=>x.app_id===app.id);
const entries=a?.ingredients||[];const features=entries.filter(i=>i.kind==='feature');const ordered=[...entries.filter(i=>i.kind==='pattern'),...features];const preview=ordered.slice(0,3);const rest=ordered.slice(3);
---
<section class="lib-section lib-design-ingredients" id="ingredients"><h2>Design ingredients</h2><p>Features and patterns documented in these captures. Their presence is separate from an ethical assessment.</p>{features.length>0&&<p class="lib-note">Features observed: {features.map((f,n)=><Fragment>{n>0?' · ':''}{f.label}</Fragment>)}</p>}
 {entries.length>0?<><dl class="lib-ingredients">{preview.map(i=><div><dt>{i.kind==='pattern'?<a href={'/patterns/'+i.pattern_slug+'/'}>{i.label}</a>:i.label}<small>{i.kind==='pattern'?'Pattern example':'Feature'} · observed in a capture</small></dt><dd><p>{i.implementation}</p><div class="lib-evidence-links">{i.evidence.slice(0,2).map((e,n)=><a href={e.url}>Inspect capture{i.evidence.length>1?' '+(n+1):''}</a>)}{i.evidence.length>2&&<a href="#research-captures">Browse the app’s capture set</a>}</div></dd></div>)}</dl>{rest.length>0?<details class="lib-ingredient-evidence" id="ingredient-evidence"><summary>Show {rest.length} more ingredients and their evidence</summary><dl class="lib-ingredients">{rest.map(i=><div><dt>{i.kind==='pattern'?<a href={'/patterns/'+i.pattern_slug+'/'}>{i.label}</a>:i.label}<small>{i.kind==='feature'?'Feature':'Pattern example'} · observed in a capture</small></dt><dd><p>{i.implementation}</p><div class="lib-evidence-links">{i.evidence.map((e,n)=><a href={e.url}>View capture{i.evidence.length>1?' '+(n+1):''}</a>)}</div></dd></div>)}</dl></details>:<div id="ingredient-evidence"/>}<p class="lib-note">A linked pattern names a design question illustrated by the capture. It does not imply every option in that pattern’s spectrum is implemented.</p></>:<p class="lib-muted">Ingredients are not yet verified against publishable captures. Missing entries do not mean a feature is absent.</p>}
</section>
