---
import data from '../../data/app-assessments.json';
import IngredientPanel from './IngredientPanel.astro';
import ProfileSelector from './ProfileSelector.astro';
const {app}=Astro.props;const a=data.apps.find(x=>x.app_id===app.id);
const entries=a?.ingredients||[];const ordered=[...entries.filter(i=>i.kind==='feature'),...entries.filter(i=>i.kind==='pattern')];
const features=ordered.filter(i=>i.kind==='feature');const primary=features.length?features:ordered.slice(0,4);const further=ordered.filter(i=>!primary.includes(i));
---
<section class="lib-section lib-design-ingredients" id="ingredients">
 <h2>Design ingredients</h2><p>Choose a feature to see the implementation and its screenshots.</p>
 {primary.length?<div data-profile-selector="Design ingredients">
  <nav class="lib-ingredient-pills" data-selector-list aria-label="Choose an ingredient">{primary.map(i=>{const n=ordered.indexOf(i);return <a id={'ingredient-tab-'+n} href={'#ingredient-'+n}>{i.label}</a>;})}</nav>
  <div id="ingredient-evidence">{primary.map(i=><IngredientPanel entry={i} index={ordered.indexOf(i)}/>)}</div>
 </div>:<p class="lib-muted">No ingredients verified against publishable captures yet. Missing entries do not mean a feature is absent.</p>}
 {further.length>0&&<details class="ingredient-further"><summary>More patterns in this app <span>{further.length} captured examples</span></summary>{further.map(i=><details class="ingredient-example"><summary>{i.label}</summary><IngredientPanel entry={i} index={ordered.indexOf(i)}/></details>)}</details>}
</section>
<ProfileSelector/>
