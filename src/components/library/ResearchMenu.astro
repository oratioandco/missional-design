---
import links from '../../../public/assets/editorial/research-sections.json';
const {de=false}=Astro.props;
const active=/^\/research(\/|$)/.test(Astro.url.pathname);
const current=(href:string)=>Astro.url.pathname===href?'page':undefined;
---
<details class="research-menu" data-research-sections>
 <summary class:list={{'is-current':active}}>{de?'Forschung (EN)':'Research'}<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></summary>
 <div class="research-menu-links" role="group" aria-label="Research">{links.map(l=><a href={l.href} aria-current={current(l.href)}><strong>{l.label}</strong><span>{l.description}</span></a>)}</div>
</details>
