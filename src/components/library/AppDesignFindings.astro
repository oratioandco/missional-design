---
import data from '../../data/app-assessments.json';
import commercial from '../../data/app-commercial-facts.json';
import rubric from '../../data/app-design-rubric.json';
import {screenFor,dateLabel} from '../../lib/app-library';
import wallet from '@phosphor-icons/core/assets/regular/wallet.svg?raw';
import sliders from '@phosphor-icons/core/assets/regular/sliders-horizontal.svg?raw';
import shield from '@phosphor-icons/core/assets/regular/shield.svg?raw';
import warning from '@phosphor-icons/core/assets/regular/warning-circle.svg?raw';
import scales from '@phosphor-icons/core/assets/regular/scales.svg?raw';
import plant from '@phosphor-icons/core/assets/regular/plant.svg?raw';
const {app}=Astro.props;const a=data.apps.find(x=>x.app_id===app.id);const cost=commercial.apps.find(x=>x.app_id===app.id);
const names:Record<string,string>={concern_evidenced:'Concern evidenced',ethical_baseline_observed:'Ethical baseline observed',redemptive_candidate:'Redemptive candidate',redemptive_practice_evidenced:'Redemptive practice evidenced',mixed:'Mixed findings',not_assessed:'Not assessed',not_applicable:'Not applicable'};
const findings=a?Object.entries(a.dimensions).filter(([,d])=>!['not_assessed','not_applicable'].includes(d.status)):[];
const reviews=a?.dimension_reviews||{};
const principleFor=(id:string)=>rubric.principles.find(p=>p.id===id);
const evidenceScreen=(url:string)=>screenFor(url.split('/').filter(Boolean).at(-1)!);
const reviewLinks=(review:any)=>review?.evidence?.map(e=>({url:e.url,name:evidenceScreen(e.url)?.screen_name||'Supporting capture'}))||[];
const firstSentence=(text?:string)=>text?.split(/(?<=[.!?])\s+(?=[A-Z])/)[0];
const money=reviews['money_access'];const attention=reviews['attention_agency'];const truth=a?.dimensions['truth_authority'];
const prices:Record<string,string>={
'app.hallow.Hallow':'7 days free, then $69.99/year. The inspected Holy Family session is locked; a Quick Novena shows a play entry.',
'is.abide.abide':'7 days free, then $39.99/year or $9.99/month. The annual plan was selected in the inspected offer.',
'io.dwellapp.dwell':'This account has lifetime access. The free-tier paywall could not be inspected.',
'com.ascension.app':'$59.99/year or $8.99/month. Closing the first offer reveals a 7-day annual trial.',
'com.bible.holy.bible.for.women':'3 days free, then $29.99/year. Initial $2.49/month wording is an annual equivalent; a separate monthly plan is $4.99.',
'com.bgolson.scripturetyper':'Free Lite entry without an account. Paid offers include $49.99/year, $12.99/month and a $149.99 one-time option.',
'com.prayapp.pray':'Premium offers 7 days free, then $99.99/year or $19.99/month. Ministry-support and family offers are separate.',
'org.crossway.ESVStudyBible':'7 days free, then $3.99/month or $39.99/year. Scripture reading remained available after declining the trial.',
'com.yourcompany.TecartaBible':'1 month free, then $5.99/month or $59.99/year. Advertising and separate ad-removal choices are also offered.',
'com.basmo.BibleChat':'7-day trials at $4.99/week or $12.99/month; annual access is $59.99/year.',
'app.biblebff':'A gift-framed offer shows $39.99/year against a crossed-out $59.99. It is a paid offer, not a verified trial.',
'app.project2b':'The visible selector shows $29.99/year or $5.99/week. Trial wording found only in hidden accessibility text is excluded.',
'com.aura.letspray':'Standard plans show $49.99/year, $12.99/month or $4.99/week. A separate first-year promotion is not a renewal quote.',
'com.topmuse.biblenote':'3 days free, then $6.99/week. A $69.99 annual alternative is also offered.',
'com.btang.manna':'7 days free, then $34.99/year, with a $9.99/month alternative. Super includes unlimited hearts and other paid benefits.',
'com.logos.ilogos':'After 1 month free: Plus $4.99/month or $49.99/year; Premium $9.99/month or $99.99/year.',
};
const controls:Record<string,string>={
'app.hallow.Hallow':'Separate notification categories and a switch to hide the prayer-streak count. Delivery and first-install defaults are untested.',
'io.dwellapp.dwell':'Reminder days and times are editable. Content, release, announcement and offer notifications have separate controls.',
'is.abide.abide':'Meditation and bedtime editors offer time and weekday choices. No reminder was saved or delivery tested.',
'com.prayapp.pray':'The reminder warns about streak loss. Premium offers two repairs per month; the repair screen also offers Continue.',
'com.basmo.BibleChat':'Free members may hold two streak freezes; Premium raises capacity to five and includes one repair per month. Execution is untested.',
'com.prayer247.lectio365':'Morning, midday and night reminders have separate switches. All were off in the inspected account.',
'com.soultime.app':'Friend nudges can be automatic or described as asking each time. Consent enforcement and triggering were not tested.',
'com.aura.letspray':'A limited-time offer reappeared after the standard offer was dismissed. Referral rewards depend on a friend subscribing.',
};
const accessText=prices[app.id]||firstSentence(money?.review_summary)||cost?.access_scopes[0]?.summary||'The sources reviewed do not establish the free and paid capability boundary.';
const controlText=controls[app.id]||firstSentence(attention?.review_summary)||'Reminder defaults, pause and missed-day recovery have not been verified.';
const trustText=truth?firstSentence(truth.reason)+' Other privacy and safeguarding questions remain open.':firstSentence(reviews['truth_authority']?.review_summary)||'Source boundaries, privacy and safeguards need further review. No app-wide assurance is implied.';
const cards=[{title:'Access & cost',icon:wallet,text:accessText,basis:money?'Captured flow · '+dateLabel(money.reviewed):'Publisher information · flow checks pending'},
{title:'Attention & control',icon:sliders,text:controlText,basis:attention?'Scoped review · '+dateLabel(attention.reviewed):'Controls not yet verified'},
{title:'Trust & care',icon:shield,text:trustText,basis:truth?'One interaction assessed':reviews['truth_authority']?'Evidence reviewed · checks remain':'Evidence incomplete'}];
const frameGroups=[
 {label:'Exploitative',icon:warning,description:'A choice subverts the person’s agency.',statuses:['concern_evidenced'],empty:'No exploitative finding established in the reviewed flows.'},
 {label:'Ethical',icon:scales,description:'A choice respects people and safeguards.',statuses:['ethical_baseline_observed'],empty:'No ethical-baseline finding assigned yet.'},
 {label:'Redemptive',icon:plant,description:'A practice restores at a cost freely borne by the builder.',statuses:['redemptive_candidate','redemptive_practice_evidenced'],empty:'Redemptive practice has not been established.'},
].map(group=>({...group,matches:findings.filter(([,f])=>group.statuses.includes(f.status))}));
const mixed= findings.filter(([,f])=>f.status==='mixed');
const findingTitles:Record<string,string>={
'app.hallow.Hallow:attention_agency':'The prayer-streak count can be hidden.',
'app.hallow.Hallow:truth_authority':'The assistant sets a boundary around blessing.',
'com.bgolson.scripturetyper:money_access':'A free entry without creating an account.',
'com.bible.holy.bible.for.women:money_access':'Later billing disclosure, with a verified exit.',
'com.prayapp.pray:attention_agency':'Paid repair sits beside a way onward.',
'io.dwellapp.dwell:attention_agency':'Stopping and pacing controls are offered.',
'is.abide.abide:truth_authority':'This meditation names its author.',
'com.aimermedia.LiveLent:formation_relationships':'A Sunday pause points toward local church.',
};
---
<section class="lib-section lib-design-review" id="assessment" aria-labelledby="design-findings-title">
 <header class="review-heading"><div><h2 id="design-findings-title">Design review</h2><p>Observed choices, what they mean, and what still needs checking.</p></div><a href="/apps/assessment/">How we review</a></header>
 <div class="review-snapshot">{cards.map(card=><section class="review-fact"><span class="review-icon" aria-hidden="true" set:html={card.icon}/><h3>{card.title}</h3><p>{card.text}</p><span class="review-basis">{card.basis}</span></section>)}</div>
 <p class="review-offer-scope">Offers are dated iOS observations in USD where captured. Eligibility, country and platform can differ. Existing settings are not installation defaults.</p>
 <section class="review-frame-panel" id="redemptive-frame" aria-labelledby="frame-title"><header><h3 id="frame-title">The redemptive frame</h3><p>Where the observed choices sit. Each finding concerns a specific flow or practice.</p></header><div class="review-frame-grid">{frameGroups.map(group=><section class="review-frame-cell" data-frame-evidence={group.matches.length?'present':'not-established'}><span class="review-icon" aria-hidden="true" set:html={group.icon}/><h4>{group.label}</h4><p>{group.description}</p><div class="review-frame-result">{group.matches.length?<><strong>{group.matches.length} scoped observation{group.matches.length===1?'':'s'}</strong><ul>{group.matches.map(([id,f])=><li><a href={'#finding-'+id}>{rubric.dimensions.find(d=>d.id===id)?.label}</a>{f.status==='redemptive_candidate'&&<span class="review-frame-candidate">Candidate · builder cost and effect unverified</span>}</li>)}</ul></>:<p>{group.empty}</p>}</div></section>)}</div>{mixed.length>0&&<div class="review-mixed"><strong>Mixed findings remain visible.</strong><p>These flows contain choices that need to be considered together, without averaging them into a grade.</p>{mixed.map(([id])=><a href={'#finding-'+id}>Read the {rubric.dimensions.find(d=>d.id===id)?.label.toLowerCase()} finding</a>)}</div>}<p class="review-frame-limit">An empty column means “not established”, not a pass or failure. A free tier, a subscription or Christian branding alone does not settle the assessment. <a href="/apps/assessment/">Read the evidence requirements</a>.</p></section>
 {findings.length>0?<div class="review-findings">{findings.map(([id,finding],index)=>{const evidence=finding.evidence.map(e=>evidenceScreen(e.url)).filter(Boolean);const shot=evidence.at(-1);const dimension=rubric.dimensions.find(d=>d.id===id)!;return <details class="review-finding-record" id={'finding-'+id} open={index===0||finding.status==='mixed'||finding.status==='concern_evidenced'}><summary><span class="review-status" data-finding-status={finding.status}>{names[finding.status]} <span>· {dimension.label}</span></span><span class="review-finding-title">{findingTitles[app.id+':'+id]||finding.scope}</span></summary><div class="review-finding">
  <div class="review-finding-copy"><p>{finding.reason}</p><p class="review-limit">{finding.limits}</p><details class="review-evidence"><summary>Evidence and principles <span>{evidence.length} capture{evidence.length===1?'':'s'}</span></summary><p class="lib-note">Scope: {finding.scope}</p><ul>{evidence.map(s=><li><a href={s.url}>{s.screen_name}</a><span> · {dateLabel(s.captured)}</span></li>)}</ul><p>Related principles</p><ul>{dimension.principle_ids.map(id=><li><a href={principleFor(id)?.url}>{principleFor(id)?.name}</a></li>)}</ul></details></div>
  {shot&&<figure class="review-finding-image"><a href={shot.url}><img src={shot.image} width="1320" height="2868" alt={shot.screen_name} loading="lazy"/></a><figcaption>{shot.screen_name} · {dateLabel(shot.captured)}</figcaption></figure>}
 </div></details>;})}</div>:<p class="review-not-yet">No scoped design finding has been assigned yet. The facts above help frame a review; they are not an ethical pass or failure.</p>}

 <details class="review-coverage" id="review-coverage"><summary>All eight review areas <span>Evidence, limits and remaining checks</span></summary><div>{rubric.dimensions.map(d=>{const finding=a?.dimensions[d.id];const review=reviews[d.id];return <section class="review-area" id={'dimension-'+d.id}><header><h3>{d.label}</h3><span>{finding?names[finding.status]:review?'Reviewed; checks remain':'Not assessed'}</span></header>{review?<><p>{review.review_summary}</p><h4>Still to check</h4><ul>{review.next_checks.map(c=><li>{c}</li>)}</ul><details class="review-evidence"><summary>Sources and related principles</summary><ul>{reviewLinks(review).map(e=><li><a href={e.url}>{e.name}</a></li>)}{d.principle_ids.map(id=><li><a href={principleFor(id)?.url}>{principleFor(id)?.name}</a></li>)}</ul><p class="lib-note">Reviewed {dateLabel(review.reviewed)}.</p></details></>:<p>No complete review for this area. Missing evidence is not a pass, failure or absent feature.</p>}{finding&&<a href={'#finding-'+d.id}>Read the scoped finding</a>}</section>;})}</div></details>
 <details class="review-checklist" id="principle-checklist"><summary>The ten principle questions <span>For your own design review</span></summary><p>These questions guide discernment; they are not ten scores for this app.</p><dl>{rubric.principles.map(p=><div id={'principle-'+p.id}><dt><a href={p.url}>{p.name}</a></dt><dd>{p.question}</dd></div>)}</dl><p><a href="/building-tools/worksheet/">Work through the principle worksheet with your team</a></p></details>
</section>
