---
import data from '../../data/app-assessments.json';
import rubric from '../../data/app-design-rubric.json';
import {screensFor,screenFor,dateLabel,articleTitle} from '../../lib/app-library';
const {app}=Astro.props;const a=data.apps.find(x=>x.app_id===app.id);const shots=screensFor(app.id);
const names:Record<string,string>={concern_evidenced:'Exploitative concern evidenced',ethical_baseline_observed:'Ethical baseline observed',redemptive_candidate:'Redemptive candidate',redemptive_practice_evidenced:'Redemptive practice evidenced',mixed:'Mixed findings',not_assessed:'Not assessed',not_applicable:'Not applicable'};
const findings=a?Object.entries(a.dimensions).filter(([,d])=>!['not_assessed','not_applicable'].includes(d.status)):[];
const principleFor=(id:string)=>rubric.principles.find(p=>p.id===id);
const evidenceScreen=(url:string)=>screenFor(url.split('/').filter(Boolean).at(-1));
const examples=[];const seen=new Set();
for(const s of shots){if(s.article_slugs.length&&!seen.has(s.article_slugs[0])){examples.push(s);seen.add(s.article_slugs[0]);if(examples.length===2)break;}}
if(!examples.length&&shots.length)examples.push(shots[0]);
const places=[['word','The Word'],['person','The person'],['practice','The practice'],['people','The people'],['makers','The makers']];
---
<section class="lib-section lib-design-profile" id="assessment" aria-labelledby="design-findings-title">
 <header class="lib-design-heading"><h2 id="design-findings-title">Principles in practice</h2><p>Observed design choices, read through <a href="/framework/">our principles</a> and the <a href="#redemptive-frame">redemptive frame</a>.</p></header>
 {findings.length?findings.map(([id,d])=>{const evidence=d.evidence.map(e=>evidenceScreen(e.url)).filter(Boolean);const lead=evidence.at(-1);return <article class="lib-design-finding" id={'finding-'+id}>
  <header><h3>{lead?.screen_name||rubric.dimensions.find(r=>r.id===id)?.label}</h3><p class="lib-finding-status">{names[d.status]||d.status}</p><p class="lib-finding-scope">{d.scope}</p></header>
  <div class="lib-finding-layout">
   {lead&&<figure><a href={lead.url} aria-label={'Inspect captured evidence: '+lead.screen_name}><img src={lead.image} width="1320" height="2868" alt={lead.screen_name} loading="eager" decoding="async"/></a><figcaption>Research capture · {dateLabel(lead.captured)}<br/><a href={lead.url}>Inspect this screen and its context</a></figcaption></figure>}
   <div class="lib-finding-reason"><h4>What we observed</h4><p>{d.reason}</p><h4>Principles behind the finding</h4><ul class="lib-finding-principles">{d.principle_ids.map(id=>{const p=principleFor(id);return p&&<li><a href={p.url}>{p.name}</a><p>{p.question}</p></li>;})}</ul><h4>What this does not establish</h4><p class="lib-finding-limit">{d.limits}</p><div class="lib-evidence-links">{evidence.map((s,n)=><a href={s.url}>{evidence.length>1?'Captured response '+(n+1):'Supporting capture'}</a>)}<a href={'#principle-'+d.principle_ids[0]}>View this finding in the checklist</a></div></div>
  </div>
 </article>;}):<div class="lib-unassessed-examples"><p class="lib-assessment-pending">No assessment finding yet. {shots.length?'These reviewed screens are examples for study, rather than an app recommendation.':'Publisher information is available below; no research captures are published for this app.'}</p>{examples.length>0&&<div class="lib-learning-examples">{examples.map(s=><article><a class="lib-learning-image" href={s.url}><img src={s.image} width="1320" height="2868" alt={s.screen_name} loading="eager" decoding="async"/></a><div><h3><a href={s.url}>{s.screen_name}</a></h3><p>{s.caption}</p>{s.article_slugs.length>0&&<p class="lib-note">Design questions: {s.article_slugs.slice(0,2).map((slug,n)=><Fragment>{n>0?' · ':''}<a href={'/patterns/'+slug+'/'}>{articleTitle(slug)}</a></Fragment>)}</p>}<a class="lib-example-source" href={s.url}>Inspect the screen and capture context</a></div></article>)}</div>}</div>}
 <details class="lib-frame-explainer" id="redemptive-frame" data-pagefind-ignore="all"><summary>Exploitative, ethical, redemptive: how to read the frame</summary><p>Our app-design lens adapts <a href="https://www.praxis.co/redemptive-entrepreneurship" target="_blank" rel="noreferrer">Praxis’s Redemptive Frame</a>. It assesses particular practices, rather than awarding an app or organisation an overall grade.</p><dl>{rubric.frame.map(f=><div id={'frame-'+f.id}><dt>{f.id==='concern'?'Exploitative concern':f.label}</dt><dd>{f.description}</dd></div>)}</dl><p class="lib-note">A subscription, free access, charity status or funding source does not determine the finding. Screenshots cannot establish an organisation’s leadership intent or its complete operations. <a href="/apps/assessment/">Full method and evidence requirements</a>.</p></details>
 <details class="lib-principle-checklist" id="principle-checklist" data-pagefind-ignore="all"><summary>Full principle checklist <span>{findings.length} scoped finding{findings.length===1?'':'s'} · {8-findings.length} assessment dimensions not assessed</span></summary><p class="lib-note">This is a map of the review, not a score. A linked finding informs a principle; it does not automatically grade that principle or the whole app. Unknown is not a pass or a failure.</p>{places.map(([place,title])=><section class="lib-principle-group"><h3>{title}</h3><dl>{rubric.principles.filter(p=>p.place===place).map(p=>{const linked=findings.filter(([,d])=>d.principle_ids.includes(p.id));return <div id={'principle-'+p.id}><dt><a href={p.url}>{p.name}</a><p>{p.question}</p></dt><dd>{linked.length?linked.map(([id,d])=><a href={'#finding-'+id}>Read the related scoped finding</a>):<span class="lib-muted">No scoped finding yet</span>}</dd></div>;})}</dl></section>)}<details class="lib-source-details"><summary>Coverage of the eight assessment dimensions</summary><dl class="lib-coverage-dimensions">{rubric.dimensions.map(d=>{const finding=findings.find(([id])=>id===d.id);return <div><dt>{d.label}</dt><dd>{finding?<a href={'#finding-'+d.id}>{names[finding[1].status]}</a>:'Not assessed'}</dd></div>;})}</dl></details></details>
</section>
