---
import data from '../../data/app-commercial-facts.json';
import OrganisationFunding from './OrganisationFunding.astro';
import {dateLabel,organisationFor} from '../../lib/app-library';
const {app}=Astro.props;const record=data.apps.find(r=>r.app_id===app.id);const org=organisationFor(app.organisation_id);
const download=record?.download;
const downloadLabel=download?.value===0?'Free download':download?.value!=null?new Intl.NumberFormat('en',{style:'currency',currency:download.currency}).format(download.value):'Download price unverified';
const status=record?.core_access.status;
const hasFreeSamples=record?.access_scopes.some(s=>s.scope==='sample_content_vs_full_catalogue'&&s.status==='free_samples_full_content_subscription');
const accessLabel=hasFreeSamples?'Free samples; full access paid':status==='publisher_states_free_access_available'?'Some free use available':status==='publisher_states_payment_required'?'Paid access required (publisher)':'Access requirements unverified';
const subscriptionLabel=record?.subscription.status==='publisher_declared'?'Subscription declared':record?.subscription.status==='publisher_mentions_church_product_subscriptions'?'Church-product subscriptions mentioned':'Subscription status unverified';
const otherLabels:Record<string,string>={publisher_mentions_donations:'Donations mentioned',publisher_claims_no_ads:'Publisher says no ads',publisher_claims_ad_free:'Publisher describes ad-free use',publisher_declares_ads_in_free_tier:'Ads in the free tier',publisher_declares_ads_by_plan:'Ads vary by plan'};
const scopeLabels:Record<string,string>={app_use_or_all_features_as_explicitly_stated:'App access, as stated by the publisher',all_app_content_or_features_as_publisher_described:'Publisher-described content and features',full_suite:'Full content suite',full_experience:'Full experience',full_power_of_app:'Publisher-described full experience',free_prayer_tier:'Free prayer tier',church_organisation_products:'Church and organisation products',app_use_vs_paid_resource_library:'App use and paid resources',sample_content_vs_full_catalogue:'Samples and the complete catalogue',daily_short_meditation_and_selected_sleep_stories:'Short daily meditation and selected sleep stories'};
const scopeName=(value:string)=>scopeLabels[value]||value.replaceAll('_',' ');
---
{record&&<div class="lib-commercial">
 <dl class="lib-commercial-glance"><div><dt>Download</dt><dd>{downloadLabel}{download&&<span> · {download.country.toUpperCase()} store</span>}</dd></div><div><dt>Access</dt><dd>{accessLabel}</dd></div></dl>
 <details class="lib-commercial-detail" id="cost-access"><summary>Cost, access &amp; publisher model <span>Sources and details</span></summary>
  <p class="lib-note">Practical facts, separate from the design assessment. Checked {dateLabel(record.checked)}. A free download does not establish free access to all content.</p>
  <dl class="lib-dl"><div><dt>App download</dt><dd>{downloadLabel}{download&&<> · {download.country.toUpperCase()} · <a href={download.source_url} target="_blank" rel="noreferrer">Store source</a></>}</dd></div><div data-pagefind-ignore={record.subscription.status==='unknown'?'all':undefined}><dt>Subscriptions</dt><dd>{subscriptionLabel}{record.subscription.source_url&&<> · <a href={record.subscription.source_url} target="_blank" rel="noreferrer">Source</a></>}</dd></div><div><dt>Store in-app products</dt><dd>{record.iap.status==='listed'?'In-app products listed':record.iap.status==='not_declared_on_retrieved_listing'?'None declared on the retrieved listing; other payment routes remain unverified':'Not verified'}</dd></div><div data-pagefind-ignore={record.donations.status==='unknown'?'all':undefined}><dt>Donations</dt><dd>{otherLabels[record.donations.status]||'Not verified'}{record.donations.source_url&&<> · <a href={record.donations.source_url} target="_blank" rel="noreferrer">Source</a></>}</dd></div><div data-pagefind-ignore={record.advertising.status==='unknown'?'all':undefined}><dt>Advertising</dt><dd>{otherLabels[record.advertising.status]||'Not verified'}{record.advertising.source_url&&<> · <a href={record.advertising.source_url} target="_blank" rel="noreferrer">Source</a></>}</dd></div></dl>
  <h2>What access does payment cover?</h2>
  {record.access_scopes.length?<ul class="lib-access-scopes">{record.access_scopes.map(s=><li><p>{s.summary}</p><p class="lib-note">Scope: {scopeName(s.scope)} · publisher statement · <a href={s.source_url} target="_blank" rel="noreferrer">Source</a>{s.related_source_urls?.map(url=><Fragment> · <a href={url} target="_blank" rel="noreferrer">Additional source</a></Fragment>)} · {dateLabel(s.checked)}</p></li>)}</ul>:<p class="lib-muted">The retrieved sources do not establish which capabilities require payment. This is unknown, rather than a claim that the app is free or paid throughout.</p>}
  <p class="lib-note">Free samples, a free tier and the complete library are different scopes. Store and publisher evidence is separate from the dated captured-flow review in Design review. Coverage varies by offer and platform.</p>
  {record.iap.products.length>0&&<details class="lib-source-details"><summary>Store-listed products and prices ({record.iap.products.length})</summary><p class="lib-note">{record.iap.storefront.toUpperCase()} App Store · checked {dateLabel(record.iap.checked)}. Names and prices describe listed products, not a personal checkout quote. Other platforms, web offers and eligibility can differ.</p><ul class="lib-price-list">{record.iap.products.map(p=><li><span>{p.name}</span><strong>{p.display_price}</strong></li>)}</ul><a href={record.iap.source_url} target="_blank" rel="noreferrer">View the store listing</a></details>}
  {record.published_prices.length>0&&<details class="lib-source-details"><summary>Publisher website price information</summary><ul class="lib-access-scopes">{record.published_prices.map(p=><li><p><strong>{p.publisher_label}: {p.display_price}</strong>{p.publisher_stated_billing_period==='one_time'?' · one-time payment':p.publisher_stated_billing_period?' · per '+p.publisher_stated_billing_period:''}</p><p class="lib-note">Publisher website · <a href={p.source_url} target="_blank" rel="noreferrer">Source</a> · checked {dateLabel(p.checked)}</p></li>)}</ul></details>}
  <OrganisationFunding organisation={org} compact/>
 </details>
</div>}
