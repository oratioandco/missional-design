---
import {dateLabel,organisationFor} from '../../lib/app-library';
const {organisation:o}=Astro.props;
---
<div class="lib-facts-columns"><section><h2>Who it serves</h2><p>{o.target_audience?.text}</p><p class="lib-note">An editorial summary of publisher positioning, rather than measured audience demographics. <a href={o.target_audience.source_url} rel="noreferrer" target="_blank">Source</a></p></section><section><h2>How it is supported</h2><p>{o.business_model.text}</p><p class="lib-note"><a href={o.business_model.source_url} rel="noreferrer" target="_blank">Publisher source</a></p></section></div>
{o.identity_note&&<p class="lib-context">{o.identity_note}</p>}
{(o.relationships||[]).map(r=>{const related=organisationFor(r.organisation_id);return <p class="lib-context">Integrates {r.service} from <a href={related.url}>{related.name}</a>. <a href={r.source_url} rel="noreferrer" target="_blank">Partnership source</a></p>})}
<section class="lib-section"><h2>Facts and figures</h2>{o.metrics.length?<><div class="lib-table-wrap"><table class="lib-table"><thead><tr><th scope="col">Figure</th><th scope="col">Value</th><th scope="col">Scope and source</th></tr></thead><tbody>{o.metrics.map(m=><tr><td>{m.label}</td><td><strong>{Number(m.value).toLocaleString('en-GB')}</strong><span>{m.unit}</span></td><td>{m.scope}<br/>{m.period}<p><a href={m.source_url} rel="noreferrer" target="_blank">{m.source_kind.replaceAll('_',' ')}</a></p>{m.limits&&<p class="lib-note">{m.limits}</p>}</td></tr>)}</tbody></table></div><p class="lib-note">Organisation figures apply to the stated entity and period. Funding, giving volume and revenue are different measures.</p></>:<p class="lib-muted">No verified revenue or audience-size figure is recorded in the sources reviewed.</p>}</section>
{o.leaders.length>0&&<section class="lib-section"><h2>Public leadership information</h2><ul class="lib-people">{o.leaders.map(p=><li><strong>{p.name}</strong><span>{p.role}</span><a href={p.source_url} rel="noreferrer" target="_blank">Source</a></li>)}</ul></section>}
<section class="lib-section"><h2>Sources and status</h2><p class="lib-note">Research profile · checked 25 October 2026. Historical roles and figures retain their dates. Information may change.</p><ul class="lib-sources">{o.sources.map(url=><li><a href={url} rel="noreferrer" target="_blank">{new URL(url).hostname.replace(/^www\./,'')}<span class="lib-note">{new URL(url).pathname==='/'?' — organisation website':' — '+new URL(url).pathname.replaceAll('-',' ').replaceAll('/',' / ')}</span></a></li>)}</ul></section>
