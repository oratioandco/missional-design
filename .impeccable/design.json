  "narrative": {
    "northStar": "Reflected Light",
    "overview": "Reflected Light pairs luminous paper and cool blue fields with navy ink, expressive editorial typography and warm urban working scenes. The fractured reflective silicon specimen carries reflected witness: broad rugged fractures, icy blue-silver sheen and a sharp four-point optical glint. It does not stand for the gospel or foundation.\n\nThe active system is the final cascade in `src/styles/reflected-light.css`, after global and historical brand styles. Native marketing remains light. The adjacent reference extends this world for sustained reading with a deliberate light/dark control and system-preference fallback. Home composition remains in its surface contract rather than becoming a universal page template.",
    "keyCharacteristics": [
      "White and pale ice-blue fields with navy ink.",
      "Instrument Serif display and short editorial passages; Mona Sans body and UI.",
      "Restrained rules, small control radii, generous editorial image fields.",
      "Warm fictional urban photography with visible generated-image disclosure."
    ],
    "rules": [
      {
        "name": "The Light Marketing Rule",
        "body": "Keep native marketing surfaces light; carry alternate reading themes through the reference's existing theme controls.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Instrument Serif for display and short editorial passages, and Mona Sans for reading, navigation and controls.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the active Reflected Light overrides as the visual source of truth.",
      "Do retain the actual approved neighborhood source and label generated fictional scenes.",
      "Do keep reading proposals visibly illustrative and preserve source/evidence distinctions.",
      "Do preserve menu, locale routing, reading controls, workbook data and one-page A3 export behavior."
    ],
    "donts": [
      "Don't inherit the historical amber, cream or Roboto Flex display palette as the new identity.",
      "Don't substitute a cross-cutout rock, abstract rock icons or unlabelled fictional testimony.",
      "Don't turn marketing preview text into evidence of observed app behavior or spiritual outcomes."
    ]
  }
